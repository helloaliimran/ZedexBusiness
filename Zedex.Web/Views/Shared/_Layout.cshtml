@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject Zedex.Application.Common.IPermissionService Permissions
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zedex Business</title>
    <link href="~/lib/bootstrap/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
@if (SignInManager.IsSignedIn(User))
{
    var modules = await Permissions.GetVisibleModulesAsync(User);
    var isAdmin = User.IsInRole("Admin");

    <div class="d-flex min-vh-100">
        <nav class="sidebar d-flex flex-column flex-shrink-0 p-3 text-bg-dark">
            <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center mb-3 text-white text-decoration-none">
                <i class="bi bi-box-seam-fill fs-4 me-2"></i>
                <span class="fs-5 fw-semibold">Zedex Business</span>
            </a>
            <hr />
            <ul class="nav nav-pills flex-column mb-auto">
                @* Modules are enabled phase by phase; unbuilt ones render as disabled "soon" items. *@
                @if (modules.Contains(AppModule.Dashboard))
                {
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Index" class="nav-link text-white">
                            <i class="bi bi-speedometer2 me-2"></i>Dashboard
                        </a>
                    </li>
                }
                @if (modules.Contains(AppModule.Products))
                {
                    <li><a asp-controller="Products" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-box me-2"></i>Products</a></li>
                    <li><a asp-controller="PvcProducts" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-box2 me-2"></i>PVC Products</a></li>
                }
                @if (modules.Contains(AppModule.Stock))
                {
                    <li><a asp-controller="Stock" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-boxes me-2"></i>Stock</a></li>
                }
                @if (modules.Contains(AppModule.Billing))
                {
                    <li><a asp-controller="Invoices" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-receipt me-2"></i>Billing</a></li>
                    <li><a asp-controller="PvcInvoices" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-receipt-cutoff me-2"></i>PVC Billing</a></li>
                }
                @if (modules.Contains(AppModule.Customers))
                {
                    <li><a asp-controller="Customers" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-people me-2"></i>Customers</a></li>
                }
                @if (modules.Contains(AppModule.CustomerLedger))
                {
                    <li><a asp-controller="Ledger" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-journal-text me-2"></i>Customer Ledger</a></li>
                }
                @if (modules.Contains(AppModule.Reports))
                {
                    <li><a asp-controller="Reports" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-bar-chart me-2"></i>Reports</a></li>
                }
                @if (isAdmin)
                {
                    <li><hr /></li>
                    <li class="nav-header text-secondary small text-uppercase px-2 mb-1">Administration</li>
                    <li><a asp-controller="Categories" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-tags me-2"></i>Categories</a></li>
                    <li><a asp-controller="Colors" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-palette me-2"></i>Colors</a></li>
                    <li><a asp-controller="Gauges" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-rulers me-2"></i>Gauges</a></li>
                    <li><a asp-controller="Companies" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-building me-2"></i>Companies</a></li>
                    <li><a asp-controller="Settings" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-sliders me-2"></i>Settings</a></li>
                    <li><a asp-controller="Users" asp-action="Index" class="nav-link text-white">
                        <i class="bi bi-person-gear me-2"></i>Users &amp; Permissions</a></li>
                }
            </ul>
            <hr />
            <div class="d-flex align-items-center justify-content-between">
                <span class="text-white small">
                    <i class="bi bi-person-circle me-1"></i>@User.Identity!.Name
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-sm btn-outline-light" title="Sign out">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </form>
            </div>
        </nav>

        <main class="flex-grow-1 bg-light">
            <div class="container-fluid p-4">
                <partial name="_Alerts" />
                @RenderBody()
            </div>
        </main>
    </div>
}
else
{
    <main class="bg-light min-vh-100 d-flex align-items-center justify-content-center">
        @RenderBody()
    </main>
}
<script src="~/lib/bootstrap/bootstrap.bundle.min.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
