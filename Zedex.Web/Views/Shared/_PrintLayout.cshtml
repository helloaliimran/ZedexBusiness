<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" asp-append-version="true" />
    <style>
        body {
            background: #f8f9fa;
            color: #000;
        }

        .print-page {
            max-width: 297mm;
            margin: 0 auto;
            background: #fff;
        }

        @@media print {
            @@page {
                size: A4 landscape;
                margin: 8mm;
            }

            body {
                background: #fff !important;
            }

            .print-page {
                max-width: none;
                margin: 0;
            }

            .no-print {
                display: none !important;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="print-page p-3 p-md-4">
        @RenderBody()
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
