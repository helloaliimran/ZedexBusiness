@model StockStatusReportViewModel
@{
    ViewData["Title"] = "Stock Status Report";
}

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h3 class="mb-0"><i class="bi bi-clipboard-data me-2"></i>Stock Status Report</h3>
    <div>
        <a asp-action="StockStatusExcel" asp-route-search="@Model.Search" asp-route-onlyInStock="@Model.OnlyInStock" asp-route-companyId="@Model.CompanyId"
           class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
        <a asp-action="StockStatusPdf" asp-route-search="@Model.Search" asp-route-onlyInStock="@Model.OnlyInStock" asp-route-companyId="@Model.CompanyId"
           class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Reports</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3 no-print">
    <div class="col-auto">
        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Product, category or color..." />
    </div>
    <div class="col-auto">
        <select name="companyId" class="form-select" asp-items="ViewBag.Companies">
            <option value="">All companies</option>
        </select>
    </div>
    <div class="col-auto d-flex align-items-center">
        <div class="form-check">
            <input type="checkbox" name="onlyInStock" value="true" class="form-check-input" id="onlyInStock"
                   checked="@Model.OnlyInStock" />
            <input type="hidden" name="onlyInStock" value="false" />
            <label class="form-check-label" for="onlyInStock">Only products currently in stock</label>
        </div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-funnel me-1"></i>Apply</button>
    </div>
    @if (!string.IsNullOrEmpty(Model.Search) || Model.CompanyId is not null)
    {
        <div class="col-auto">
            <a asp-action="StockStatus" class="btn btn-link">Clear</a>
        </div>
    }
</form>

<div class="row g-2 mb-3">
    <div class="col-6 col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body py-2">
            <div class="text-muted small text-uppercase">Products listed</div>
            <div class="fs-5 fw-semibold">@Model.TotalProducts.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body py-2">
            <div class="text-muted small text-uppercase">In stock</div>
            <div class="fs-5 fw-semibold text-success">@Model.InStockCount.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body py-2">
            <div class="text-muted small text-uppercase">Out of stock</div>
            <div class="fs-5 fw-semibold text-danger">@Model.OutOfStockCount.ToString("N0")</div>
        </div></div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0 sortable-table">
            <thead class="table-light">
                <tr>
                    <th data-sort="text">Product</th>
                    <th data-sort="text">Category</th>
                    <th data-sort="text">Company</th>
                    <th data-sort="text">Color</th>
                    <th data-sort="text">Gauge</th>
                    <th data-sort="text">Mode</th>
                    <th class="text-end" data-sort="number">Current Stock</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4"><i class="bi bi-inbox me-1"></i>No products match.</td></tr>
                }
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td class="fw-medium">@row.Name</td>
                        <td>@row.Category</td>
                        <td>@(row.Company ?? "—")</td>
                        <td>@row.Color</td>
                        <td>@row.Gauge</td>
                        <td>@row.ModeLabel</td>
                        <td class="text-end fw-semibold @(row.StockValue < 0 ? "text-danger" : row.StockValue == 0 ? "text-muted" : "")"
                            data-sort-value="@row.StockValue">
                            @row.StockLabel
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/sortable-table.js" asp-append-version="true"></script>
}
