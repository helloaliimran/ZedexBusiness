@model DailyBillReportViewModel
@{
    ViewData["Title"] = "Daily Bill Report";
}

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h3 class="mb-0"><i class="bi bi-receipt me-2"></i>Daily Bill Report</h3>
    <div>
        <a asp-action="DailyBillsExcel" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")"
           asp-route-type="@Model.Type" asp-route-userName="@Model.UserName" asp-route-search="@Model.Search"
           class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
        <a asp-action="DailyBillsPdf" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")"
           asp-route-type="@Model.Type" asp-route-userName="@Model.UserName" asp-route-search="@Model.Search"
           class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Reports</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3 no-print">
    <div class="col-6 col-md-2">
        <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-6 col-md-2">
        <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-6 col-md-2">
        <select name="type" class="form-select">
            <option value="">All payments</option>
            <option value="Cash" selected="@(Model.Type == PaymentType.Cash)">Cash</option>
            <option value="Partial" selected="@(Model.Type == PaymentType.Partial)">Partial</option>
            <option value="Credit" selected="@(Model.Type == PaymentType.Credit)">Credit</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <select name="userName" class="form-select" asp-items="ViewBag.Workers">
            <option value="">All users</option>
        </select>
    </div>
    <div class="col-12 col-md-2">
        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Bill # or customer..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-funnel me-1"></i>Apply</button>
    </div>
</form>

<p class="text-muted mb-2">@Model.From.ToString("dd MMM yyyy")@(Model.From != Model.To ? $" — {Model.To:dd MMM yyyy}" : "") · @Model.Rows.Count bill(s)</p>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Bill #</th>
                    <th>Customer</th>
                    <th class="text-end">Total Amount</th>
                    <th class="text-end">Paid</th>
                    <th>Payment Type</th>
                    <th>User</th>
                    <th>Date &amp; Time</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4"><i class="bi bi-inbox me-1"></i>No bills in this period.</td></tr>
                }
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td class="fw-medium">
                            <a asp-controller="Invoices" asp-action="Details" asp-route-id="@row.Id"
                               class="text-decoration-none">@row.InvoiceNumber</a>
                        </td>
                        <td>@row.Customer</td>
                        <td class="text-end">@row.Total.ToString("N2")</td>
                        <td class="text-end">@row.PaidAmount.ToString("N2")</td>
                        <td>
                            <span class="badge @(row.PaymentType switch {
                                PaymentType.Cash => "text-bg-success",
                                PaymentType.Partial => "text-bg-warning",
                                _ => "text-bg-danger" })">@row.PaymentType</span>
                        </td>
                        <td>@(row.PostedBy ?? "—")</td>
                        <td>@row.PostedDate?.ToString("dd MMM yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <td colspan="2" class="text-end fw-semibold">Totals</td>
                    <td class="text-end fw-bold">@Model.TotalAmount.ToString("N2")</td>
                    <td class="text-end fw-semibold">@Model.TotalPaid.ToString("N2")</td>
                    <td colspan="3"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
