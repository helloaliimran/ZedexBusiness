@model DailySalesReportViewModel
@{
    ViewData["Title"] = "Daily Sales Report";
}

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h3 class="mb-0"><i class="bi bi-graph-up me-2"></i>Daily Sales Report</h3>
    <div>
        <a asp-action="DailySalesExcel" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")"
           asp-route-userName="@Model.UserName" asp-route-customerId="@Model.CustomerId"
           class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
        <a asp-action="DailySalesPdf" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")"
           asp-route-userName="@Model.UserName" asp-route-customerId="@Model.CustomerId"
           class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Reports</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3 no-print">
    <div class="col-6 col-md-2">
        <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-6 col-md-2">
        <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-6 col-md-2">
        <select name="userName" class="form-select" asp-items="ViewBag.Workers">
            <option value="">All workers</option>
        </select>
    </div>
    <div class="col-6 col-md-3">
        <select name="customerId" class="form-select" asp-items="ViewBag.Customers">
            <option value="">All customers</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-funnel me-1"></i>Apply</button>
    </div>
</form>

@* Summary cards *@
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3 col-xl">
        <div class="card shadow-sm"><div class="card-body py-2">
            <div class="text-muted small">Total Bills</div>
            <div class="fs-6 fw-bold">@Model.TotalBills</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3 col-xl">
        <div class="card shadow-sm"><div class="card-body py-2">
            <div class="text-muted small">Total Sales</div>
            <div class="fs-6 fw-bold">Rs. @Model.TotalSales.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3 col-xl">
        <div class="card shadow-sm"><div class="card-body py-2">
            <div class="text-muted small">Cash Sales</div>
            <div class="fs-6 fw-bold">Rs. @Model.TotalCash.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3 col-xl">
        <div class="card shadow-sm"><div class="card-body py-2">
            <div class="text-muted small">Credit Sales</div>
            <div class="fs-6 fw-bold">Rs. @Model.TotalCredit.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3 col-xl">
        <div class="card shadow-sm"><div class="card-body py-2">
            <div class="text-muted small">Partial Payments</div>
            <div class="fs-6 fw-bold">Rs. @Model.TotalPartial.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3 col-xl">
        <div class="card shadow-sm"><div class="card-body py-2">
            <div class="text-muted small">Total Collection</div>
            <div class="fs-6 fw-bold text-success">Rs. @Model.TotalCollection.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3 col-xl">
        <div class="card shadow-sm"><div class="card-body py-2">
            <div class="text-muted small">Outstanding</div>
            <div class="fs-6 fw-bold text-danger">Rs. @Model.TotalOutstanding.ToString("N0")</div>
        </div></div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th class="text-end">Bills</th>
                    <th class="text-end">Sales</th>
                    <th class="text-end">Cash</th>
                    <th class="text-end">Credit</th>
                    <th class="text-end">Partial</th>
                    <th class="text-end">Collection</th>
                    <th class="text-end">Outstanding</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4"><i class="bi bi-inbox me-1"></i>No sales in this period.</td></tr>
                }
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td class="fw-medium">@row.Date.ToString("dd MMM yyyy")</td>
                        <td class="text-end">@row.Bills</td>
                        <td class="text-end">@row.Sales.ToString("N2")</td>
                        <td class="text-end">@row.Cash.ToString("N2")</td>
                        <td class="text-end">@row.Credit.ToString("N2")</td>
                        <td class="text-end">@row.Partial.ToString("N2")</td>
                        <td class="text-end">@row.Collection.ToString("N2")</td>
                        <td class="text-end @(row.Outstanding > 0 ? "text-danger" : "")">@row.Outstanding.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <td class="fw-semibold">Totals</td>
                    <td class="text-end fw-semibold">@Model.TotalBills</td>
                    <td class="text-end fw-bold">@Model.TotalSales.ToString("N2")</td>
                    <td class="text-end fw-semibold">@Model.TotalCash.ToString("N2")</td>
                    <td class="text-end fw-semibold">@Model.TotalCredit.ToString("N2")</td>
                    <td class="text-end fw-semibold">@Model.TotalPartial.ToString("N2")</td>
                    <td class="text-end fw-semibold text-success">@Model.TotalCollection.ToString("N2")</td>
                    <td class="text-end fw-bold text-danger">@Model.TotalOutstanding.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
