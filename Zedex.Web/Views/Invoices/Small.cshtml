@model InvoiceDetailsViewModel
@{
    ViewData["Title"] = $"{Model.InvoiceNumber} (Small)";
}

<style>
    .receipt {
        max-width: 320px;
        margin: 0 auto;
        font-size: 13px;
        line-height: 1.35;
        color: #000;
    }

    .receipt table {
        width: 100%;
        border-collapse: collapse;
    }

    .receipt th, .receipt td {
        padding: 3px 4px;
        vertical-align: top;
        border: 1px solid #000;
        color: #000;
    }

    .receipt thead th {
        background: #e5e5e5;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.02em;
    }

    .receipt tfoot td {
        padding-top: 3px;
    }

    .receipt .totals-rule td,
    .receipt tfoot tr:first-child td {
        border-top: 2px solid #000;
    }

    .receipt .grand-total td {
        border-top: 2px solid #000;
        background: #f0f0f0;
        font-weight: 700;
    }

    .receipt .item-name {
        word-break: break-word;
        line-height: 1.25;
    }

    @@media print {
        @@page {
            size: 80mm auto;
            margin: 2mm;
        }

        body, main {
            margin: 0 !important;
            padding: 0 !important;
        }

        main.p-4, .p-4 {
            padding: 0 !important;
        }

        body {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .receipt {
            max-width: none;
            width: 76mm;
            font-size: 11.5px;
            margin: 0;
        }

        .receipt .card, .receipt .card-body {
            border: none !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .receipt th, .receipt td {
            padding: 2px 3px;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h3 class="mb-0"><i class="bi bi-receipt-cutoff me-2"></i>Small Invoice</h3>
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="bi bi-receipt me-1"></i>Full invoice
        </a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="receipt">
    <div class="card shadow-sm">
        <div class="card-body p-2">
            <div class="text-center mb-1">
                <div class="fw-bold" style="font-size: 1.35em;">@Model.PrintTitle</div>
                <div>@Model.InvoiceNumber — @Model.InvoiceDate.ToString("dd MMM yyyy")</div>
                <div>@Model.CustomerName</div>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Item</th>
                        <th class="text-center">Qty</th>
                        <th class="text-center">Size</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="item-name">@row.Product</td>
                            <td class="text-center">@row.Quantity</td>
                            <td class="text-center">@(row.SizeFt is null ? "—" : $"{row.SizeFt:0.##} ft")</td>
                            <td class="text-end">@row.LineTotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    @if (Model.FurtherDiscount > 0)
                    {
                        <tr>
                            <td colspan="3" class="text-end">Further discount</td>
                            <td class="text-end">− @Model.FurtherDiscount.ToString("N2")</td>
                        </tr>
                    }
                    <tr class="totals-rule">
                        <td colspan="3" class="text-end fw-semibold">Total (this bill)</td>
                        <td class="text-end fw-bold">@Model.Total.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-end">Previous balance</td>
                        <td class="text-end">@Model.PreviousBalance.ToString("N2")</td>
                    </tr>
                    @if (!Model.IsPosted)
                    {
                        <tr class="grand-total">
                            <td colspan="3" class="text-end">Grand total</td>
                            <td class="text-end">@Model.GrandTotalWithPrevious.ToString("N2")</td>
                        </tr>
                    }
                    else
                    {
                        @if (Model.PaidAmount > 0)
                        {
                            <tr>
                                <td colspan="3" class="text-end">Paid</td>
                                <td class="text-end">@Model.PaidAmount.ToString("N2")</td>
                            </tr>
                        }
                        <tr class="grand-total">
                            <td colspan="3" class="text-end">Closing balance</td>
                            <td class="text-end">@Model.CustomerBalance.ToString("N2")</td>
                        </tr>
                    }
                </tfoot>
            </table>
            <div class="text-center mt-1 fw-semibold" style="font-size: 1em;">Thank you!</div>
        </div>
    </div>
</div>
