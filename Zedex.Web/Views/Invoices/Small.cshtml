@model InvoiceDetailsViewModel
@{
    ViewData["Title"] = $"{Model.InvoiceNumber} (Small)";
}

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h3 class="mb-0"><i class="bi bi-receipt-cutoff me-2"></i>Small Invoice</h3>
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="bi bi-receipt me-1"></i>Full invoice
        </a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-center mb-3">
                    <h5 class="mb-0">Zedex Business</h5>
                    <div class="text-muted small">@Model.InvoiceNumber — @Model.InvoiceDate.ToString("dd MMM yyyy")</div>
                    <div class="small">@Model.CustomerName</div>
                </div>
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td>@row.Product</td>
                                <td class="text-end">@row.LineTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        @if (Model.FurtherDiscount > 0)
                        {
                            <tr>
                                <td class="text-end text-muted">Further discount</td>
                                <td class="text-end">− @Model.FurtherDiscount.ToString("N2")</td>
                            </tr>
                        }
                        <tr class="table-light">
                            <td class="text-end fw-semibold">Total (this bill)</td>
                            <td class="text-end fw-bold">Rs. @Model.Total.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td class="text-end text-muted">Previous balance</td>
                            <td class="text-end">Rs. @Model.PreviousBalance.ToString("N2")</td>
                        </tr>
                        @if (!Model.IsPosted)
                        {
                            <tr class="table-light">
                                <td class="text-end fw-semibold">Grand total</td>
                                <td class="text-end fw-bold">Rs. @Model.GrandTotalWithPrevious.ToString("N2")</td>
                            </tr>
                        }
                        else
                        {
                            @if (Model.PaidAmount > 0)
                            {
                                <tr>
                                    <td class="text-end text-muted">Paid</td>
                                    <td class="text-end">Rs. @Model.PaidAmount.ToString("N2")</td>
                                </tr>
                            }
                            <tr class="table-light">
                                <td class="text-end fw-semibold">Closing balance</td>
                                <td class="text-end fw-bold @(Model.CustomerBalance > 0 ? "text-danger" : "")">
                                    Rs. @Model.CustomerBalance.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
