@model InvoiceFormViewModel
@{
    ViewData["Title"] = "New Invoice";
}

<h3 class="mb-3"><i class="bi bi-receipt me-2"></i>New Invoice <span class="badge text-bg-secondary">Draft</span></h3>
<p class="text-muted">The invoice is saved as a draft. Stock and the customer ledger update only when you post it.</p>

<form asp-action="Create" method="post">
    <partial name="_InvoiceForm" model="Model" />
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i>Save draft
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.invoiceProducts = @Html.Raw(Json.Serialize(ViewBag.ProductsJson));
        window.invoiceCustomers = @Html.Raw(Json.Serialize(ViewBag.CustomersJson));
        window.invoiceInitialRows = @Html.Raw(Json.Serialize(Model.Items));
    </script>
    <script src="~/js/invoice-entry.js" asp-append-version="true"></script>
}
