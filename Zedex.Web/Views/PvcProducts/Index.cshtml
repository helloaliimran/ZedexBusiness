@model PvcProductListViewModel
@{
    ViewData["Title"] = "PVC Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-box2 me-2"></i>PVC Products</h3>
    <div>
        <a asp-action="QuickEntry" class="btn btn-outline-primary">
            <i class="bi bi-lightning-charge me-1"></i>Quick Entry
        </a>
        <a asp-action="Rates" class="btn btn-outline-primary">
            <i class="bi bi-currency-exchange me-1"></i>Update Rates
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add PVC Product
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-12 col-md-3">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search name / color / gauge…" />
            </div>
            <div class="col-6 col-md-2">
                <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">All categories</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select name="companyId" class="form-select" asp-items="ViewBag.Companies">
                    <option value="">All companies</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select name="colorId" class="form-select" asp-items="ViewBag.Colors">
                    <option value="">All colors</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select name="gaugeId" class="form-select" asp-items="ViewBag.Gauges">
                    <option value="">All gauges</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select name="saleType" class="form-select">
                    <option value="">All sale types</option>
                    <option value="PerRunningFoot" selected="@(Model.SaleType == PvcSaleType.PerRunningFoot)">Per Running Ft</option>
                    <option value="WeightPerLength" selected="@(Model.SaleType == PvcSaleType.WeightPerLength)">Weight / Length</option>
                    <option value="RatePerLength" selected="@(Model.SaleType == PvcSaleType.RatePerLength)">Rate / Length</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
            </div>
            @if (!string.IsNullOrEmpty(Model.Search) || Model.CategoryId is not null || Model.CompanyId is not null || Model.ColorId is not null || Model.GaugeId is not null || Model.SaleType is not null)
            {
                <div class="col-auto"><a asp-action="Index" class="btn btn-link">Clear</a></div>
            }
        </form>

        <table class="table table-hover align-middle">
            <thead class="table-light table-compact-header">
                <tr>
                    <th title="Name">Name</th>
                    <th title="Category">Cat.</th>
                    <th title="Company">Co.</th>
                    <th title="Color">Color</th>
                    <th title="Gauge">Gauge</th>
                    <th title="Sale Type">Type</th>
                    <th title="Gas Kit">Kit</th>
                    <th class="text-end" title="Rate">Rate</th>
                    <th class="text-end" title="Weight / Length">Wt/Len</th>
                    <th class="text-end" title="Quantity">Qty</th>
                    <th class="text-end" style="width: 140px;" title="Actions"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Items.Any())
                {
                    <tr><td colspan="11" class="text-center text-muted py-4"><i class="bi bi-inbox me-1"></i>No PVC products found.</td></tr>
                }
                @foreach (var product in Model.Items.Items)
                {
                    <tr>
                        <td class="fw-medium">@product.Name</td>
                        <td>@product.Category</td>
                        <td>@product.Company</td>
                        <td>@product.Color</td>
                        <td>@product.Gauge</td>
                        <td>
                            <span class="badge @product.SaleTypeBadgeClass">
                                @product.SaleTypeLabel
                            </span>
                        </td>
                        <td>
                            <span class="badge @(product.GasKitType == GasKitType.None ? "text-bg-secondary" : "text-bg-primary")">
                                @product.GasKitLabel
                            </span>
                        </td>
                        <td class="text-end">@product.RateLabel</td>
                        <td class="text-end">@(product.WeightPerLength is null ? "—" : $"{product.WeightPerLength:N3} kg")</td>
                        <td class="text-end @(product.StockQty < 0 ? "text-danger fw-semibold" : "")">@product.StockQty.ToString("N0")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete PVC product &quot;@product.Name&quot;?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.Items.TotalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Items.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-categoryId="@Model.CategoryId" asp-route-companyId="@Model.CompanyId" asp-route-colorId="@Model.ColorId"
                           asp-route-gaugeId="@Model.GaugeId" asp-route-saleType="@Model.SaleType"
                           asp-route-page="@(Model.Items.Page - 1)">&laquo;</a>
                    </li>
                    @for (var p = 1; p <= Model.Items.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Items.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                               asp-route-categoryId="@Model.CategoryId" asp-route-companyId="@Model.CompanyId" asp-route-colorId="@Model.ColorId"
                               asp-route-gaugeId="@Model.GaugeId" asp-route-saleType="@Model.SaleType"
                               asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Items.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-categoryId="@Model.CategoryId" asp-route-companyId="@Model.CompanyId" asp-route-colorId="@Model.ColorId"
                           asp-route-gaugeId="@Model.GaugeId" asp-route-saleType="@Model.SaleType"
                           asp-route-page="@(Model.Items.Page + 1)">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
