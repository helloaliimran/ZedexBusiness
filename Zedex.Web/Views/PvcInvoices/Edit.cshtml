@model PvcInvoiceFormViewModel
@{
    ViewData["Title"] = $"Edit PVC Invoice {ViewBag.InvoiceNumber}";
}

<h3 class="mb-3"><i class="bi bi-receipt me-2"></i>Edit PVC Invoice @ViewBag.InvoiceNumber <span class="badge text-bg-secondary">Draft</span></h3>
<p class="text-muted">You can change items while the invoice is a draft. Post it to update stock and the customer ledger.</p>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <partial name="_PvcInvoiceForm" model="Model" />
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i>Save changes
    </button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.pvcProducts = @Html.Raw(Json.Serialize(ViewBag.ProductsJson));
        window.pvcCustomers = @Html.Raw(Json.Serialize(ViewBag.CustomersJson));
        window.pvcInitialRows = @Html.Raw(Json.Serialize(Model.Items));
        window.pvcGasKitRate = @Html.Raw(Json.Serialize(ViewBag.GasKitRate));
    </script>
    <script src="~/js/product-search.js" asp-append-version="true"></script>
    <script src="~/js/pvc-invoice-entry.js" asp-append-version="true"></script>
}
