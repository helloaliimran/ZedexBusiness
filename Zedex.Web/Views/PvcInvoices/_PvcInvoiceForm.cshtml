@model PvcInvoiceFormViewModel

<div asp-validation-summary="All" class="text-danger small mb-2"></div>

<div class="card shadow-sm mb-3">
    <div class="card-header bg-white fw-semibold"><i class="bi bi-card-heading me-1"></i>PVC invoice details</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-5">
                <label asp-for="CustomerId" class="form-label"></label>
                <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                    <option value="0">— Select customer —</option>
                </select>
                <div class="form-text" id="custBalanceHint"></div>
                <span asp-validation-for="CustomerId" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="InvoiceDate" class="form-label"></label>
                <input asp-for="InvoiceDate" class="form-control" type="date" />
                <span asp-validation-for="InvoiceDate" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Remarks" class="form-label"></label>
                <input asp-for="Remarks" class="form-control" />
                <span asp-validation-for="Remarks" class="text-danger small"></span>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">
            <i class="bi bi-list-ul me-1"></i>Items
            <span class="text-muted small ms-2">Gas kit rate: Rs. @(((decimal)ViewBag.GasKitRate).ToString("N2")) / ft (default — editable per line)</span>
        </span>
        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow()">
            <i class="bi bi-plus-lg me-1"></i>Add item
        </button>
    </div>
    <div class="card-body p-0">
        <table class="table align-middle mb-0">
            <thead class="table-light table-compact-header">
                <tr>
                    <th style="min-width: 220px;">Item</th>
                    <th style="width: 90px;" title="Length (ft)">Length</th>
                    <th style="width: 65px;" title="Quantity">Qty</th>
                    <th style="width: 100px;" title="Gas Kit">GK</th>
                    <th style="width: 90px;" title="Weight per length (kg)">Wt/Len</th>
                    <th style="width: 90px;" title="Rate">Rate</th>
                    <th style="width: 110px;" title="Discount % — applies to lengths + gas kit combined">Disc%</th>
                    <th style="width: 85px;" class="text-end" title="Total feet / weight (kg)">Ft/Kg</th>
                    <th style="width: 80px;" class="text-end" title="Gas kit amount (Rs.) — editable; defaults to rate × length × qty">GK Rs.</th>
                    <th style="width: 120px;" class="text-end" title="Line total — editable; round it and the discount % adjusts (discount applies to lengths + gas kit combined)">Total</th>
                    <th style="width: 40px;"></th>
                </tr>
            </thead>
            <tbody id="itemsBody"></tbody>
        </table>
    </div>
    <div class="card-footer bg-white">
        <div class="row justify-content-end">
            <div class="col-md-4 col-lg-3">
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Subtotal</span>
                    <span id="subTotalDisplay" class="fw-medium">Rs. 0.00</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Line discounts</span>
                    <span id="discountDisplay">Rs. 0.00</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-1">
                    <label asp-for="FurtherDiscount" class="text-muted mb-0">Further discount</label>
                    <div class="input-group input-group-sm" style="width: 140px;">
                        <span class="input-group-text">Rs.</span>
                        <input asp-for="FurtherDiscount" class="form-control text-end" type="number" step="0.01" min="0" />
                    </div>
                </div>
                <hr class="my-1" />
                <div class="d-flex justify-content-between py-1">
                    <span class="fw-semibold">Total</span>
                    <span id="grandTotalDisplay" class="fw-bold">Rs. 0.00</span>
                </div>
                <span asp-validation-for="FurtherDiscount" class="text-danger small"></span>
            </div>
        </div>
    </div>
</div>
