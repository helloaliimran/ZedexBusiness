@model PvcInvoiceDetailsViewModel
@{
    ViewData["Title"] = $"{Model.InvoiceNumber} – Pick List";
}

<style>
    /* ── Screen layout ── */
    .pl-wrap {
        max-width: 740px;
        margin: 0 auto;
        font-size: 13px;
        font-family: 'Segoe UI', Arial, sans-serif;
    }

    .pl-title {
        text-align: center;
        font-size: 1.4em;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border-bottom: 2px solid #000;
        padding-bottom: 4px;
        margin-bottom: 6px;
    }

    .pl-meta {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 0.92em;
    }

    .pl-section {
        margin-bottom: 8px;
    }

    .pl-section label {
        font-weight: 600;
        min-width: 90px;
        display: inline-block;
        font-size: 0.88em;
        color: #555;
    }

    .pl-field {
        border: none;
        border-bottom: 1px dashed #aaa;
        background: transparent;
        font-size: 1em;
        width: calc(100% - 100px);
        padding: 1px 4px;
        font-family: inherit;
    }

    .pl-field:focus {
        outline: none;
        border-bottom-color: #0d6efd;
        background: #f0f4ff;
    }

    .pl-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

    .pl-table thead th {
        border-top: 2px solid #000;
        border-bottom: 1px solid #000;
        padding: 3px 6px;
        text-align: left;
        font-size: 0.88em;
        background: #f8f9fa;
    }

    .pl-table tbody td {
        padding: 4px 6px;
        border-bottom: 1px solid #dee2e6;
        vertical-align: top;
    }

    .pl-table tfoot td {
        border-top: 2px solid #000;
        padding: 4px 6px;
    }

    .text-end { text-align: right; }
    .text-center { text-align: center; }

    .pl-driver {
        margin-top: 16px;
        padding-top: 8px;
        border-top: 1px dashed #aaa;
    }

    .pl-sign-row {
        display: flex;
        gap: 40px;
        margin-top: 20px;
    }

    .pl-sign-box {
        flex: 1;
        border-top: 1px solid #000;
        padding-top: 2px;
        font-size: 0.85em;
        text-align: center;
    }

    /* ── Print: common ── */
    @@media print {
        .no-print { display: none !important; }
        body, main { margin: 0 !important; padding: 0 !important; }
        main.p-4, .p-4 { padding: 4mm !important; }

        .pl-wrap { max-width: 100%; }

        .pl-field {
            border-bottom: 1px dashed #000;
            background: transparent !important;
        }

        .pl-table tbody td { padding: 2px 4px; }
    }

    /* ── Toast notification ── */
    #pl-toast {
        display: none;
        position: fixed;
        bottom: 28px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(20, 20, 20, 0.92);
        color: #fff;
        padding: 10px 24px;
        border-radius: 24px;
        z-index: 9999;
        font-size: 14px;
        pointer-events: none;
        transition: opacity 0.3s;
        white-space: nowrap;
    }
</style>

<style id="pl-style-a5">
    @@media print {
        @@page { size: A5 portrait; margin: 10mm; }
        .pl-wrap { font-size: 10pt; }
    }
</style>
<style id="pl-style-thermal" media="not all">
    @@media print {
        @@page { size: 80mm auto; margin: 2mm; }
        .pl-wrap { max-width: 76mm; font-size: 8pt; }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h3 class="mb-0"><i class="bi bi-boxes me-2"></i>Pick List</h3>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="bi bi-receipt me-1"></i>Full invoice
        </a>
        <button type="button" class="btn btn-outline-secondary" onclick="printAs('a5')">
            <i class="bi bi-printer me-1"></i>Print A5
        </button>
        <button type="button" class="btn btn-outline-secondary" onclick="printAs('thermal')">
            <i class="bi bi-receipt-cutoff me-1"></i>Print 80mm
        </button>
        <button type="button" class="btn btn-success" onclick="copyImage()" title="Copy as image — then paste in WhatsApp Web">
            <i class="bi bi-clipboard-image me-1"></i>Copy Image
        </button>
        <button type="button" class="btn btn-success" onclick="shareWhatsApp()" title="Share via WhatsApp (mobile) or copy image (desktop)">
            <i class="bi bi-whatsapp me-1"></i>Share
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="pl-wrap">

    @* <div class="pl-title">Warehouse Pick List</div> *@

    <div class="pl-meta">
        <span><strong>Invoice:</strong> @Model.InvoiceNumber</span>
        <span><strong>Date:</strong> @Model.InvoiceDate.ToString("dd MMM yyyy")</span>
    </div>

    <div class="pl-section">
        <label>Customer</label>
        <input class="pl-field" type="text" value="@Model.CustomerName" placeholder="Customer name" />
    </div>
    <div class="pl-section">
        <label>Address</label>
        <input class="pl-field" type="text" value="@(Model.CustomerAddress ?? "")" placeholder="Address" />
    </div>
    <div class="pl-section">
        <label>Phone</label>
        <input class="pl-field" type="text" value="@(Model.CustomerPhone ?? "")" placeholder="Phone number" />
    </div>

    <table class="pl-table">
        <thead>
            <tr>
                <th style="width:30px;">#</th>
                <th>Item (Name / Gauge / Color)</th>
                <th class="thermal-hide">Company</th>
                <th class="thermal-hide">Description</th>
                <th class="text-center" style="width:70px;">Size (ft)</th>
                <th class="text-center" style="width:50px;">Qty</th>
                <th class="text-center no-print" style="width:55px;">&#10003; Done</th>
            </tr>
        </thead>
        <tbody>
            @{ int rowNum = 0; }
            @foreach (var row in Model.Rows)
            {
                rowNum++;
                <tr>
                    <td class="text-center">@rowNum</td>
                    <td>@row.Item</td>
                    <td class="thermal-hide">@(string.IsNullOrEmpty(row.Company) ? "—" : row.Company)</td>
                    <td class="thermal-hide">@(string.IsNullOrEmpty(row.Code) ? "—" : row.Code)</td>
                    <td class="text-center">@row.LengthFt.ToString("0.##") ft</td>
                    <td class="text-center fw-bold">@row.Quantity</td>
                    <td class="text-center no-print">
                        <input type="checkbox" style="width:16px;height:16px;" />
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="5" class="text-end fw-semibold">Total items</td>
                <td class="text-center fw-bold">@Model.Rows.Sum(r => r.Quantity)</td>
                <td class="no-print"></td>
            </tr>
        </tfoot>
    </table>

    <div class="pl-driver">
        <label style="font-weight:600;font-size:0.88em;color:#555;min-width:90px;display:inline-block;">Driver Name</label>
        <input class="pl-field" type="text" value="" placeholder="Leave empty if no delivery" />
    </div>

    <div class="pl-sign-row">
        <div class="pl-sign-box">Prepared by</div>
        <div class="pl-sign-box">Warehouse</div>
        <div class="pl-sign-box">Driver</div>
    </div>

</div>

<div id="pl-toast"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"
        integrity="sha512-BNaRQnYJYiPSqHHDb58B0yaPfCu+Wgds8Gp/gU33kqBtgNS4tSPHuGibyoeqMV/TJlSKda6FXzoEyYGjTe+vXA=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>

<script>
    // ── Print ──────────────────────────────────────────────
    function printAs(mode) {
        var isThermal = mode === 'thermal';
        document.getElementById('pl-style-a5').setAttribute('media', isThermal ? 'not all' : '');
        document.getElementById('pl-style-thermal').setAttribute('media', isThermal ? '' : 'not all');
        document.querySelectorAll('.thermal-hide').forEach(function (el) {
            el.style.display = isThermal ? 'none' : '';
        });
        window.print();
        setTimeout(function () {
            document.getElementById('pl-style-a5').setAttribute('media', '');
            document.getElementById('pl-style-thermal').setAttribute('media', 'not all');
            document.querySelectorAll('.thermal-hide').forEach(function (el) {
                el.style.display = '';
            });
        }, 1500);
    }

    // ── Toast helper ───────────────────────────────────────
    var _toastTimer;
    function showToast(msg, ms) {
        var t = document.getElementById('pl-toast');
        t.textContent = msg;
        t.style.display = 'block';
        t.style.opacity = '1';
        clearTimeout(_toastTimer);
        _toastTimer = setTimeout(function () {
            t.style.opacity = '0';
            setTimeout(function () { t.style.display = 'none'; t.style.opacity = '1'; }, 350);
        }, ms || 4000);
    }

    // ── Capture pick-list area as a canvas ─────────────────
    async function capturePlWrap() {
        var noprint = document.querySelectorAll('.no-print');
        noprint.forEach(function (el) { el.style.visibility = 'hidden'; });
        var canvas = await html2canvas(document.querySelector('.pl-wrap'), {
            backgroundColor: '#ffffff',
            scale: 2,
            useCORS: true,
            logging: false
        });
        noprint.forEach(function (el) { el.style.visibility = ''; });
        return canvas;
    }

    function canvasToBlob(canvas) {
        return new Promise(function (res) { canvas.toBlob(res, 'image/png'); });
    }

    function downloadCanvas(canvas, name) {
        var a = document.createElement('a');
        a.href = canvas.toDataURL('image/png');
        a.download = name || 'pick-list.png';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }

    // ── Copy Image ─────────────────────────────────────────
    async function copyImage() {
        showToast('Capturing…', 8000);
        var canvas;
        try {
            canvas = await capturePlWrap();
            var blob = await canvasToBlob(canvas);
            await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
            showToast('✅ Image copied! Open WhatsApp Web and paste (Ctrl+V / ⌘V).');
        } catch (err) {
            if (canvas) {
                downloadCanvas(canvas);
                showToast('Clipboard blocked — image downloaded. Attach it in WhatsApp.');
            } else {
                showToast('Capture failed: ' + err.message);
            }
        }
    }

    // ── Share / WhatsApp ───────────────────────────────────
    async function shareWhatsApp() {
        showToast('Capturing…', 8000);
        var canvas;
        try {
            canvas = await capturePlWrap();
            var blob = await canvasToBlob(canvas);
            var file = new File([blob], 'pick-list.png', { type: 'image/png' });

            if (navigator.share && navigator.canShare && navigator.canShare({ files: [file] })) {
                await navigator.share({ files: [file], title: 'Pick List' });
                showToast('Shared!', 2500);
            } else {
                try {
                    await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
                    showToast('✅ Image copied! Open WhatsApp Web and paste (Ctrl+V / ⌘V).', 6000);
                } catch {
                    downloadCanvas(canvas);
                    showToast('Image downloaded — attach it in WhatsApp.');
                }
            }
        } catch (err) {
            if (err.name === 'AbortError') return;
            if (canvas) {
                downloadCanvas(canvas);
                showToast('Share failed — image downloaded instead.');
            } else {
                showToast('Capture failed: ' + err.message);
            }
        }
    }
</script>
