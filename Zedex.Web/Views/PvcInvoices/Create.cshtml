@model PvcInvoiceFormViewModel
@{
    ViewData["Title"] = "New PVC Invoice";
}

<h3 class="mb-3"><i class="bi bi-receipt me-2"></i>New PVC Invoice <span class="badge text-bg-secondary">Draft</span></h3>
<p class="text-muted">The invoice is saved as a draft. Stock and the customer ledger update only when you post it.</p>

<form asp-action="Create" method="post">
    <partial name="_PvcInvoiceForm" model="Model" />
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i>Save draft
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.pvcProducts = @Html.Raw(Json.Serialize(ViewBag.ProductsJson));
        window.pvcCustomers = @Html.Raw(Json.Serialize(ViewBag.CustomersJson));
        window.pvcInitialRows = @Html.Raw(Json.Serialize(Model.Items));
        window.pvcGasKitRate = @Html.Raw(Json.Serialize(ViewBag.GasKitRate));
    </script>
    <script src="~/js/product-search.js" asp-append-version="true"></script>
    <script src="~/js/pvc-invoice-entry.js" asp-append-version="true"></script>
}
