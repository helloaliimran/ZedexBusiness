@model LedgerViewModel
@{
    ViewData["Title"] = $"Ledger — {Model.CustomerName}";
    var isAdmin = User.IsInRole("Admin");
}

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h3 class="mb-0"><i class="bi bi-journal-text me-2"></i>Ledger — @Model.CustomerName
        @if (Model.Phone is not null)
        {
            <small class="text-muted fs-6">(@Model.Phone)</small>
        }
    </h3>
    <div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#entryModal">
            <i class="bi bi-plus-lg me-1"></i>Add Entry
        </button>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3 no-print">
    <input type="hidden" name="id" value="@Model.CustomerId" />
    <div class="col-6 col-md-2">
        <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-6 col-md-2">
        <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-funnel me-1"></i>Filter</button>
    </div>
    @if (Model.From is not null || Model.To is not null)
    {
        <div class="col-auto"><a asp-action="Ledger" asp-route-id="@Model.CustomerId" class="btn btn-link">Clear</a></div>
    }
</form>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card shadow-sm"><div class="card-body py-2">
            <div class="text-muted small">Opening balance</div>
            <div class="fs-6 fw-semibold">Rs. @Model.OpeningBalance.ToString("N2")</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm"><div class="card-body py-2">
            <div class="text-muted small">Total debit</div>
            <div class="fs-6 fw-semibold">Rs. @Model.TotalDebit.ToString("N2")</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm"><div class="card-body py-2">
            <div class="text-muted small">Total credit</div>
            <div class="fs-6 fw-semibold">Rs. @Model.TotalCredit.ToString("N2")</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm"><div class="card-body py-2">
            <div class="text-muted small">Closing balance</div>
            <div class="fs-6 fw-bold @(Model.ClosingBalance > 0 ? "text-danger" : "text-success")">
                Rs. @Model.ClosingBalance.ToString("N2")
            </div>
        </div></div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th class="text-end">Debit</th>
                    <th class="text-end">Credit</th>
                    <th class="text-end">Balance</th>
                    <th>By</th>
                    <th class="no-print" style="width: 60px;"></th>
                </tr>
            </thead>
            <tbody>
                <tr class="table-light">
                    <td colspan="5" class="fw-medium">Opening balance</td>
                    <td class="text-end fw-semibold">Rs. @Model.OpeningBalance.ToString("N2")</td>
                    <td></td>
                    <td class="no-print"></td>
                </tr>
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4"><i class="bi bi-inbox me-1"></i>No ledger activity in this period.</td></tr>
                }
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.Date.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="badge @(row.Type switch {
                                LedgerEntryType.Bill => "text-bg-danger",
                                LedgerEntryType.Payment => "text-bg-success",
                                LedgerEntryType.Return => "text-bg-info",
                                LedgerEntryType.Credit => "text-bg-primary",
                                _ => "text-bg-warning" })">@row.Type</span>
                        </td>
                        <td>
                            @if (row.InvoiceId is not null)
                            {
                                <a asp-controller="Invoices" asp-action="Details" asp-route-id="@row.InvoiceId"
                                   class="text-decoration-none">@row.Remarks</a>
                            }
                            else
                            {
                                @row.Remarks
                            }
                        </td>
                        <td class="text-end">@(row.Debit > 0 ? $"Rs. {row.Debit:N2}" : "—")</td>
                        <td class="text-end">@(row.Credit > 0 ? $"Rs. {row.Credit:N2}" : "—")</td>
                        <td class="text-end fw-medium @(row.Balance > 0 ? "text-danger" : "")">Rs. @row.Balance.ToString("N2")</td>
                        <td class="small text-muted">@(row.CreatedBy ?? "—")</td>
                        <td class="no-print text-end">
                            @if (row.IsManual && isAdmin)
                            {
                                <form asp-action="ReverseEntry" asp-route-id="@row.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Post a reversal entry of Rs. @((row.Debit + row.Credit).ToString("N2"))? The original entry stays visible; an opposite entry cancels its effect.');">
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Reverse entry (posts an opposite entry)">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <td colspan="3" class="text-end fw-semibold">Totals</td>
                    <td class="text-end fw-semibold">Rs. @Model.TotalDebit.ToString("N2")</td>
                    <td class="text-end fw-semibold">Rs. @Model.TotalCredit.ToString("N2")</td>
                    <td class="text-end fw-bold @(Model.ClosingBalance > 0 ? "text-danger" : "text-success")">
                        Rs. @Model.ClosingBalance.ToString("N2")
                    </td>
                    <td></td>
                    <td class="no-print"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="modal fade" id="entryModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="AddEntry" method="post" class="modal-content">
            <input type="hidden" name="CustomerId" value="@Model.CustomerId" />
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-lg me-1"></i>Add Ledger Entry — @Model.CustomerName</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Entry type</label>
                    <select name="EntryType" class="form-select">
                        <option value="Payment">Payment received (credit)</option>
                        <option value="Credit">Credit adjustment (reduces balance)</option>
                        <option value="Debit">Debit adjustment (increases balance)</option>
                    </select>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label">Amount (Rs.)</label>
                        <input type="number" name="Amount" class="form-control" step="0.01" min="0.01" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Date</label>
                        <input type="date" name="EntryDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label">Remarks</label>
                    <input type="text" name="Remarks" class="form-control" maxlength="500" required
                           placeholder="e.g. Cash received / balance correction" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save entry</button>
            </div>
        </form>
    </div>
</div>
