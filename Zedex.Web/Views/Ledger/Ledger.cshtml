@model LedgerViewModel
@{
    ViewData["Title"] = $"Ledger — {Model.CustomerName}";
    var isAdmin = User.IsInRole("Admin");
}
@functions {
    // Hide ".00" when the amount is whole; keep real decimals.
    static string M(decimal v) => v == decimal.Truncate(v) ? v.ToString("N0") : v.ToString("N2");
}

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h3 class="mb-0"><i class="bi bi-journal-text me-2"></i>Ledger — @Model.CustomerName
        @if (Model.Phone is not null)
        {
            <small class="text-muted fs-6">(@Model.Phone)</small>
        }
    </h3>
    <div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#entryModal">
            <i class="bi bi-plus-lg me-1"></i>Add Entry
        </button>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

@* Print-only header — the interactive header above is hidden on print (.no-print),
   so the customer name is repeated here for the printed copy. *@
<div class="d-none d-print-flex justify-content-between align-items-baseline mb-3 ledger-print-header">
    <h4 class="mb-0">Customer Ledger — @Model.CustomerName
        @if (Model.Phone is not null)
        {
            <small class="text-muted">(@Model.Phone)</small>
        }
    </h4>
    <span class="text-muted small">
        @if (Model.From is not null || Model.To is not null)
        {
            @($"{Model.From?.ToString("dd MMM yyyy") ?? "…"} – {Model.To?.ToString("dd MMM yyyy") ?? "…"}")
        }
        Printed @DateTime.Now.ToString("dd MMM yyyy HH:mm")
    </span>
</div>

<form method="get" class="row g-2 mb-3 no-print">
    <input type="hidden" name="id" value="@Model.CustomerId" />
    <div class="col-6 col-md-2">
        <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-6 col-md-2">
        <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-funnel me-1"></i>Filter</button>
    </div>
    @if (Model.From is not null || Model.To is not null)
    {
        <div class="col-auto"><a asp-action="Ledger" asp-route-id="@Model.CustomerId" class="btn btn-link">Clear</a></div>
    }
</form>

<div class="row g-2 mb-3 ledger-summary">
    <div class="col-6 col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body py-2">
            <div class="text-muted summary-label">Opening balance <span class="text-muted">(Rs.)</span></div>
            <div class="summary-value">@M(Model.OpeningBalance)</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body py-2">
            <div class="text-muted summary-label">Total debit <span class="text-muted">(Rs.)</span></div>
            <div class="summary-value text-danger">@M(Model.TotalDebit)</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body py-2">
            <div class="text-muted summary-label">Total credit <span class="text-muted">(Rs.)</span></div>
            <div class="summary-value text-success">@M(Model.TotalCredit)</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm h-100 border-2 @(Model.ClosingBalance > 0 ? "border-danger" : "border-success")"><div class="card-body py-2">
            <div class="text-muted summary-label">Closing balance <span class="text-muted">(Rs.)</span></div>
            <div class="summary-value summary-closing fw-bold @(Model.ClosingBalance > 0 ? "text-danger" : "text-success")">
                @M(Model.ClosingBalance)
            </div>
        </div></div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0 table-responsive ledger-scroll">
        <table class="table table-sm table-hover align-middle mb-0 ledger-table">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th class="text-end col-debit">Debit (Rs.)</th>
                    <th class="text-end col-credit">Credit (Rs.)</th>
                    <th class="text-end">Balance (Rs.)</th>
                    <th>By</th>
                    <th class="no-print" style="width: 60px;"></th>
                </tr>
            </thead>
            <tbody>
                <tr class="table-light">
                    <td colspan="5" class="fw-medium">Opening balance</td>
                    <td class="text-end fw-semibold num">@M(Model.OpeningBalance)</td>
                    <td></td>
                    <td class="no-print"></td>
                </tr>
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4"><i class="bi bi-inbox me-1"></i>No ledger activity in this period.</td></tr>
                }
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.Date.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="badge @(row.Type switch {
                                LedgerEntryType.Bill => "text-bg-danger",
                                LedgerEntryType.Payment => "text-bg-success",
                                LedgerEntryType.Return => "text-bg-info",
                                LedgerEntryType.Credit => "text-bg-primary",
                                _ => "text-bg-warning" })">@row.Type</span>
                        </td>
                        <td>
                            @if (row.InvoiceId is not null)
                            {
                                <a asp-controller="Invoices" asp-action="Details" asp-route-id="@row.InvoiceId"
                                   class="text-decoration-none">@row.Remarks</a>
                            }
                            else
                            {
                                @row.Remarks
                            }
                        </td>
                        <td class="text-end num col-debit">@(row.Debit > 0 ? M(row.Debit) : "")</td>
                        <td class="text-end num col-credit">@(row.Credit > 0 ? M(row.Credit) : "")</td>
                        <td class="text-end num fw-medium @(row.Balance > 0 ? "text-danger" : row.Balance < 0 ? "text-success" : "")">@M(row.Balance)</td>
                        <td class="small text-muted">@(row.CreatedBy ?? "—")</td>
                        <td class="no-print text-end">
                            @if (row.IsManual && isAdmin)
                            {
                                <form asp-action="ReverseEntry" asp-route-id="@row.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Post a reversal entry of Rs. @((row.Debit + row.Credit).ToString("N2"))? The original entry stays visible; an opposite entry cancels its effect.');">
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Reverse entry (posts an opposite entry)">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <td colspan="3" class="text-end fw-semibold">Totals (Rs.)</td>
                    <td class="text-end fw-semibold num col-debit">@M(Model.TotalDebit)</td>
                    <td class="text-end fw-semibold num col-credit">@M(Model.TotalCredit)</td>
                    <td class="text-end fw-bold num @(Model.ClosingBalance > 0 ? "text-danger" : "text-success")">
                        @M(Model.ClosingBalance)
                    </td>
                    <td></td>
                    <td class="no-print"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="modal fade" id="entryModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="AddEntry" method="post" class="modal-content">
            <input type="hidden" name="CustomerId" value="@Model.CustomerId" />
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-lg me-1"></i>Add Ledger Entry — @Model.CustomerName</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Entry type</label>
                    <select name="EntryType" class="form-select">
                        <option value="Payment">Payment received (credit)</option>
                        <option value="Credit">Credit adjustment (reduces balance)</option>
                        <option value="Debit">Debit adjustment (increases balance)</option>
                    </select>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label">Amount (Rs.)</label>
                        <input type="number" name="Amount" class="form-control" step="0.01" min="0.01" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Date</label>
                        <input type="date" name="EntryDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label">Remarks</label>
                    <input type="text" name="Remarks" class="form-control" maxlength="500" required
                           placeholder="e.g. Cash received / balance correction" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save entry</button>
            </div>
        </form>
    </div>
</div>
