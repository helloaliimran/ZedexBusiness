@model LedgerIndexViewModel
@{
    ViewData["Title"] = "Customer Ledger";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-journal-text me-2"></i>Customer Ledger</h3>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-auto">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search name or phone..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search me-1"></i>Search</button>
            </div>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <div class="col-auto"><a asp-action="Index" class="btn btn-link">Clear</a></div>
            }
        </form>

        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Customer</th>
                    <th>Phone</th>
                    <th class="text-end">Total bills</th>
                    <th class="text-end">Total received</th>
                    <th class="text-end">Balance</th>
                    <th class="text-end" style="width: 130px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Items.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-inbox me-1"></i>No customers found.</td></tr>
                }
                @foreach (var customer in Model.Items.Items)
                {
                    <tr>
                        <td class="fw-medium">
                            <a asp-action="Ledger" asp-route-id="@customer.Id" class="text-decoration-none">@customer.Name</a>
                        </td>
                        <td>@(customer.Phone ?? "—")</td>
                        <td class="text-end">Rs. @customer.TotalBills.ToString("N2")</td>
                        <td class="text-end">Rs. @customer.TotalPaid.ToString("N2")</td>
                        <td class="text-end @(customer.Balance > 0 ? "text-danger fw-semibold" : "text-success")">
                            Rs. @customer.Balance.ToString("N2")
                        </td>
                        <td class="text-end">
                            <a asp-action="Ledger" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-journal-text me-1"></i>Ledger
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.Items.TotalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Items.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-page="@(Model.Items.Page - 1)">&laquo;</a>
                    </li>
                    @for (var p = 1; p <= Model.Items.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Items.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Items.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-page="@(Model.Items.Page + 1)">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
