@model EmployeeFormViewModel
@{
    ViewData["Title"] = "Add Employee";
}

<div class="row">
    <div class="col-xl-9">
        <h3 class="mb-3"><i class="bi bi-person-badge me-2"></i>Add Employee</h3>
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <partial name="_EmployeeForm" model="Model" />
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save employee</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
