@model EmployeeListViewModel
@{
    ViewData["Title"] = "Employees";
    string Per(EmployeePayType t) => t switch { EmployeePayType.Daily => "day", EmployeePayType.Weekly => "week", _ => "month" };
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h3 class="mb-0"><i class="bi bi-person-badge me-2"></i>Employees</h3>
    <div>
        <a asp-action="Summary" class="btn btn-outline-secondary"><i class="bi bi-table me-1"></i>Payments Summary</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Add Employee</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3 align-items-center">
            <div class="col-auto">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search name, phone, CNIC..." />
            </div>
            <div class="col-auto form-check ms-2">
                <input type="checkbox" name="showInactive" value="true" class="form-check-input" id="showInactive" checked="@Model.ShowInactive" />
                <label class="form-check-label" for="showInactive">Show inactive</label>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search me-1"></i>Search</button>
            </div>
            <div class="col text-end small text-muted">
                Total advance outstanding: <span class="fw-bold text-danger">Rs. @Model.TotalAdvanceOutstanding.ToString("N0")</span>
            </div>
        </form>

        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width:56px;"></th>
                    <th>Name</th>
                    <th>Designation</th>
                    <th>Phone</th>
                    <th>CNIC</th>
                    <th class="text-end">Pay</th>
                    <th class="text-end">Advance Balance</th>
                    <th class="text-end" style="width:120px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Items.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4"><i class="bi bi-inbox me-1"></i>No employees found.</td></tr>
                }
                @foreach (var e in Model.Items.Items)
                {
                    <tr class="@(e.IsActive ? "" : "text-muted")">
                        <td>
                            @if (e.HasPhoto)
                            {
                                <img src="@Url.Action("Document", new { id = e.Id, kind = "photo" })" class="rounded-circle" style="width:40px;height:40px;object-fit:cover;" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-secondary-subtle text-secondary fw-semibold" style="width:40px;height:40px;">@e.Name[..1].ToUpper()</span>
                            }
                        </td>
                        <td class="fw-medium">
                            <a asp-action="Details" asp-route-id="@e.Id" class="text-decoration-none">@e.Name</a>
                            @if (!e.IsActive) { <span class="badge text-bg-secondary ms-1">Inactive</span> }
                        </td>
                        <td>@(e.Designation ?? "—")</td>
                        <td>@(e.Phone ?? "—")</td>
                        <td class="text-nowrap">@(e.Cnic ?? "—")</td>
                        <td class="text-end text-nowrap">Rs. @e.PayRate.ToString("N0") / @Per(e.PayType)</td>
                        <td class="text-end @(e.AdvanceBalance > 0 ? "text-danger fw-semibold" : "")">Rs. @e.AdvanceBalance.ToString("N0")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary" title="Statement"><i class="bi bi-journal-text"></i></a>
                            <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.Items.TotalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    @for (var p = 1; p <= Model.Items.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Items.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-showInactive="@Model.ShowInactive" asp-route-page="@p">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>
