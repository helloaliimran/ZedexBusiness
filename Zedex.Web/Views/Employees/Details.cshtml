@model EmployeeDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
    var isAdmin = User.IsInRole("Admin");
    string F(DateTime d) => d.ToString("yyyy-MM-dd");
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h3 class="mb-0">
        <i class="bi bi-person-badge me-2"></i>@Model.Name
        @if (!Model.IsActive) { <span class="badge text-bg-secondary fs-6 align-middle">Inactive</span> }
    </h3>
    <div class="d-flex gap-1 flex-wrap">
        <a asp-action="PaySalary" asp-route-id="@Model.Id" class="btn btn-success"><i class="bi bi-cash-stack me-1"></i>Pay Salary</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
        <form asp-action="ToggleActive" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi @(Model.IsActive ? "bi-pause-circle" : "bi-play-circle") me-1"></i>@(Model.IsActive ? "Mark inactive" : "Mark active")
            </button>
        </form>
        @if (isAdmin && !Model.Rows.Any() && Model.OpeningAdvanceBalance == 0)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
                  onsubmit="return confirm('Delete employee &quot;@Model.Name&quot;?');">
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="row g-3">
    @* ---- Profile ---- *@
    <div class="col-lg-4 col-xl-3">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                @if (Model.HasPhoto)
                {
                    <img src="@Url.Action("Document", new { id = Model.Id, kind = "photo" })" class="rounded-circle mb-3" style="width:120px;height:120px;object-fit:cover;" alt="" />
                }
                else
                {
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-secondary-subtle text-secondary fw-bold fs-1 mb-3" style="width:120px;height:120px;">@Model.Name[..1].ToUpper()</span>
                }
                <h5 class="mb-0">@Model.Name</h5>
                <div class="text-muted">@(Model.Designation ?? "—")</div>
            </div>
            <ul class="list-group list-group-flush small">
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Father name</span><span>@(Model.FatherName ?? "—")</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Phone</span><span>@(Model.Phone ?? "—")</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">CNIC</span><span>@(Model.Cnic ?? "—")</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Joined</span><span>@Model.JoiningDate.ToString("dd MMM yyyy")</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Pay</span><span class="fw-semibold">@Model.PayLabel</span></li>
                <li class="list-group-item"><div class="text-muted">Address</div>@(Model.Address ?? "—")</li>
                @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                {
                    <li class="list-group-item"><div class="text-muted">Remarks</div>@Model.Remarks</li>
                }
                @if (Model.HasCnicFront || Model.HasCnicBack)
                {
                    <li class="list-group-item">
                        <div class="text-muted mb-1">CNIC scans</div>
                        <div class="d-flex gap-2">
                            @if (Model.HasCnicFront)
                            {
                                <a asp-action="Document" asp-route-id="@Model.Id" asp-route-kind="cnic-front" target="_blank">
                                    <img src="@Url.Action("Document", new { id = Model.Id, kind = "cnic-front" })" class="border rounded" style="width:100px;height:64px;object-fit:cover;" alt="CNIC front" />
                                </a>
                            }
                            @if (Model.HasCnicBack)
                            {
                                <a asp-action="Document" asp-route-id="@Model.Id" asp-route-kind="cnic-back" target="_blank">
                                    <img src="@Url.Action("Document", new { id = Model.Id, kind = "cnic-back" })" class="border rounded" style="width:100px;height:64px;object-fit:cover;" alt="CNIC back" />
                                </a>
                            }
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="col-lg-8 col-xl-9">
        @* ---- Key figures ---- *@
        <div class="row g-3 mb-3">
            <div class="col-6 col-md-3">
                <div class="card shadow-sm h-100 border-start border-4 border-danger"><div class="card-body py-2">
                    <div class="text-muted small">Advance outstanding</div>
                    <div class="fs-5 fw-bold @(Model.CurrentAdvanceBalance > 0 ? "text-danger" : "")">Rs. @Model.CurrentAdvanceBalance.ToString("N0")</div>
                </div></div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card shadow-sm h-100"><div class="card-body py-2">
                    <div class="text-muted small">Salary paid up to</div>
                    <div class="fs-6 fw-bold">@(Model.LastSalaryPeriodTo?.ToString("dd MMM yyyy") ?? "Never paid")</div>
                </div></div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card shadow-sm h-100"><div class="card-body py-2">
                    <div class="text-muted small">Cash paid (period)</div>
                    <div class="fs-5 fw-bold">Rs. @Model.PeriodNetPaid.ToString("N0")</div>
                </div></div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card shadow-sm h-100"><div class="card-body py-2">
                    <div class="text-muted small">Advance given (period)</div>
                    <div class="fs-5 fw-bold">Rs. @Model.PeriodAdvanceGiven.ToString("N0")</div>
                </div></div>
            </div>
        </div>

        @* ---- Give advance / bonus ---- *@
        <div class="card shadow-sm mb-3">
            <div class="card-body py-2">
                <form asp-action="AddAdvance" method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="EmployeeId" value="@Model.Id" />
                    <div class="col-6 col-md-2">
                        <label class="form-label small mb-0">Type</label>
                        <select name="Type" class="form-select form-select-sm">
                            <option value="Advance" selected>Advance</option>
                            <option value="Bonus">Bonus</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small mb-0">Date</label>
                        <input type="date" name="Date" value="@F(DateTime.Today)" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small mb-0">Amount (Rs.)</label>
                        <input type="number" name="Amount" step="0.01" min="0.01" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small mb-0">Paid from</label>
                        <select name="PaymentSource" class="form-select form-select-sm">
                            <option value="Cash" selected>Cash</option>
                            <option value="Online">Online</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label small mb-0">Remarks</label>
                        <input type="text" name="Remarks" maxlength="500" class="form-control form-control-sm" />
                    </div>
                    <div class="col-12 col-md-1 d-grid">
                        <button type="submit" class="btn btn-sm btn-warning"><i class="bi bi-plus-lg"></i> Give</button>
                    </div>
                </form>
            </div>
        </div>

        @* ---- Statement ---- *@
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <form method="get" class="row g-2 align-items-center">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="col-auto fw-semibold"><i class="bi bi-journal-text me-1"></i>Statement</div>
                    <div class="col-auto"><input type="date" name="from" value="@F(Model.From)" class="form-control form-control-sm" /></div>
                    <div class="col-auto"><input type="date" name="to" value="@F(Model.To)" class="form-control form-control-sm" /></div>
                    <div class="col-auto"><button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-funnel"></i></button></div>
                    <div class="col text-end">
                        <a asp-action="StatementExcel" asp-route-id="@Model.Id" asp-route-from="@F(Model.From)" asp-route-to="@F(Model.To)" class="btn btn-sm btn-outline-success"><i class="bi bi-file-earmark-excel"></i> Excel</a>
                        <a asp-action="StatementPdf" asp-route-id="@Model.Id" asp-route-from="@F(Model.From)" asp-route-to="@F(Model.To)" class="btn btn-sm btn-outline-danger"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
                    </div>
                </form>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Period</th>
                            <th class="text-end">Gross</th>
                            <th class="text-end">Adv. Given</th>
                            <th class="text-end">Adv. Deducted</th>
                            <th class="text-end">Cash Paid</th>
                            <th>From</th>
                            <th class="text-end">Adv. Balance</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="table-light">
                            <td>@Model.From.ToString("dd MMM yyyy")</td>
                            <td colspan="7" class="text-muted">Opening advance balance</td>
                            <td class="text-end fw-semibold">@Model.OpeningAdvanceBalance.ToString("N2")</td>
                            <td></td>
                        </tr>
                        @if (!Model.Rows.Any())
                        {
                            <tr><td colspan="10" class="text-center text-muted py-3">No payments in this period.</td></tr>
                        }
                        @foreach (var r in Model.Rows)
                        {
                            var deletable = isAdmin || r.CreatedDate.Date == DateTime.Today;
                            var badge = r.Type switch
                            {
                                EmployeeTransactionType.SalaryPayment => "text-bg-success",
                                EmployeeTransactionType.Advance => "text-bg-warning",
                                _ => "text-bg-info"
                            };
                            <tr>
                                <td class="text-nowrap">@r.Date.ToString("dd MMM yyyy")</td>
                                <td><span class="badge @badge">@r.TypeLabel</span></td>
                                <td class="small text-nowrap">@(r.PeriodFrom is null ? "" : $"{r.PeriodFrom:dd MMM} – {r.PeriodTo:dd MMM yy}")</td>
                                <td class="text-end">@(r.GrossAmount == 0 ? "" : r.GrossAmount.ToString("N2"))</td>
                                <td class="text-end">@(r.AdvanceGiven == 0 ? "" : r.AdvanceGiven.ToString("N2"))</td>
                                <td class="text-end">@(r.AdvanceDeducted == 0 ? "" : r.AdvanceDeducted.ToString("N2"))</td>
                                <td class="text-end fw-semibold">@r.NetPaid.ToString("N2")</td>
                                <td class="small">@r.PaymentSource</td>
                                <td class="text-end @(r.AdvanceBalance > 0 ? "text-danger" : "")">@r.AdvanceBalance.ToString("N2")</td>
                                <td class="text-end text-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(r.Remarks))
                                    {
                                        <i class="bi bi-chat-left-text text-muted" title="@r.Remarks"></i>
                                    }
                                    @if (deletable)
                                    {
                                        <form asp-action="DeleteTransaction" asp-route-id="@r.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete this @r.TypeLabel entry of Rs. @r.NetPaid.ToString("N2")?');">
                                            <button type="submit" class="btn btn-sm btn-link text-danger p-0 ms-1" title="Delete"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="fw-semibold">Totals</td>
                            <td class="text-end fw-semibold">@Model.PeriodGross.ToString("N2")</td>
                            <td class="text-end fw-semibold">@Model.PeriodAdvanceGiven.ToString("N2")</td>
                            <td class="text-end fw-semibold">@Model.PeriodDeducted.ToString("N2")</td>
                            <td class="text-end fw-bold">@Model.PeriodNetPaid.ToString("N2")</td>
                            <td colspan="3"></td>
                        </tr>
                    </tfoot>
                </table>
                </div>
            </div>
        </div>
    </div>
</div>
