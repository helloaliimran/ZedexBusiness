@using Microsoft.AspNetCore.Mvc.Rendering
@model ProductQuickEntryViewModel
@{
    ViewData["Title"] = "Quick Product Entry";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-lightning-charge me-2"></i>Quick Product Entry</h3>
    <div>
        <a asp-action="Rates" class="btn btn-outline-secondary"><i class="bi bi-currency-exchange me-1"></i>Update Rates</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Products</a>
    </div>
</div>
<p class="text-muted">Add many products at once. <kbd>Enter</kbd> in the Price field adds a new row that copies the category, color, and pricing mode. The <i class="bi bi-files"></i> button duplicates a row.</p>

<form asp-action="QuickEntry" method="post">
    <div asp-validation-summary="All" class="text-danger small mb-2"></div>

    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><i class="bi bi-list-ul me-1"></i>New products</span>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow()">
                <i class="bi bi-plus-lg me-1"></i>Add row
            </button>
        </div>
        <div class="card-body p-0">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 40px;">#</th>
                        <th style="min-width: 200px;">Product name</th>
                        <th style="width: 160px;">Category</th>
                        <th style="width: 140px;">Color</th>
                        <th style="width: 120px;">Gauge</th>
                        <th style="width: 130px;">Pricing</th>
                        <th style="width: 140px;">Price (Rs.)</th>
                        <th style="width: 90px;"></th>
                    </tr>
                </thead>
                <tbody id="rowsBody"></tbody>
            </table>
        </div>
    </div>

    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save all products</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <script>
        window.quickLookups = {
            categories: @Html.Raw(Json.Serialize(((SelectList)ViewBag.Categories).Select(x => new { id = x.Value, name = x.Text }))),
            colors: @Html.Raw(Json.Serialize(((SelectList)ViewBag.Colors).Select(x => new { id = x.Value, name = x.Text }))),
            gauges: @Html.Raw(Json.Serialize(((SelectList)ViewBag.Gauges).Select(x => new { id = x.Value, name = x.Text })))
        };
        window.quickInitialRows = @Html.Raw(Json.Serialize(Model.Rows));
    </script>
    <script src="~/js/product-quick-entry.js" asp-append-version="true"></script>
}
