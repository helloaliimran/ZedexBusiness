@model ProductListViewModel
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-box me-2"></i>Products</h3>
    <div>
        <a asp-action="QuickEntry" class="btn btn-outline-primary">
            <i class="bi bi-lightning-charge me-1"></i>Quick Entry
        </a>
        <a asp-action="Rates" class="btn btn-outline-primary">
            <i class="bi bi-currency-exchange me-1"></i>Update Rates
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Product
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-12 col-md-3">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search name / color / gauge…" />
            </div>
            <div class="col-6 col-md-2">
                <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">All categories</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select name="colorId" class="form-select" asp-items="ViewBag.Colors">
                    <option value="">All colors</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select name="gaugeId" class="form-select" asp-items="ViewBag.Gauges">
                    <option value="">All gauges</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select name="mode" class="form-select">
                    <option value="">All pricing</option>
                    <option value="PerUnit" selected="@(Model.Mode == PricingMode.PerUnit)">Per Unit</option>
                    <option value="PerFoot" selected="@(Model.Mode == PricingMode.PerFoot)">Per Foot</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
            </div>
            @if (!string.IsNullOrEmpty(Model.Search) || Model.CategoryId is not null || Model.ColorId is not null || Model.GaugeId is not null || Model.Mode is not null)
            {
                <div class="col-auto"><a asp-action="Index" class="btn btn-link">Clear</a></div>
            }
        </form>

        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Color</th>
                    <th>Gauge</th>
                    <th>Pricing</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Items.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4"><i class="bi bi-inbox me-1"></i>No products found.</td></tr>
                }
                @foreach (var product in Model.Items.Items)
                {
                    <tr>
                        <td class="fw-medium">@product.Name</td>
                        <td>@product.Category</td>
                        <td>@product.Color</td>
                        <td>@product.Gauge</td>
                        <td>
                            <span class="badge @(product.PricingMode == PricingMode.PerFoot ? "text-bg-warning" : "text-bg-secondary")">
                                @product.PricingLabel
                            </span>
                        </td>
                        <td class="text-end">Rs. @product.Price.ToString("N2")</td>
                        <td class="text-end @(product.CurrentStock < 0 ? "text-danger fw-semibold" : "")">@product.StockLabel</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete product &quot;@product.Name&quot;?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.Items.TotalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Items.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-categoryId="@Model.CategoryId" asp-route-colorId="@Model.ColorId"
                           asp-route-gaugeId="@Model.GaugeId" asp-route-mode="@Model.Mode"
                           asp-route-page="@(Model.Items.Page - 1)">&laquo;</a>
                    </li>
                    @for (var p = 1; p <= Model.Items.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Items.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                               asp-route-categoryId="@Model.CategoryId" asp-route-colorId="@Model.ColorId"
                               asp-route-gaugeId="@Model.GaugeId" asp-route-mode="@Model.Mode"
                               asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Items.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-categoryId="@Model.CategoryId" asp-route-colorId="@Model.ColorId"
                           asp-route-gaugeId="@Model.GaugeId" asp-route-mode="@Model.Mode"
                           asp-route-page="@(Model.Items.Page + 1)">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
