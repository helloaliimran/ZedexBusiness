@model CustomerListViewModel
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-people me-2"></i>Customers</h3>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i>Add Customer
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-auto">
                <input type="text" name="search" value="@Model.Search" class="form-control"
                       placeholder="Search name, phone, address..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search me-1"></i>Search</button>
            </div>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <div class="col-auto"><a asp-action="Index" class="btn btn-link">Clear</a></div>
            }
        </form>

        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 56px;"></th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th class="text-end">Balance</th>
                    <th class="text-end" style="width: 180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Items.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-inbox me-1"></i>No customers found.</td></tr>
                }
                @foreach (var customer in Model.Items.Items)
                {
                    <tr>
                        <td>
                            @if (customer.ImagePath is not null)
                            {
                                <img src="@customer.ImagePath" class="rounded-circle" style="width:40px;height:40px;object-fit:cover;" alt="" />
                            }
                            else
                            {
                                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-secondary-subtle text-secondary fw-semibold"
                                      style="width:40px;height:40px;">@customer.Name[..1].ToUpper()</span>
                            }
                        </td>
                        <td class="fw-medium">
                            <a asp-action="Details" asp-route-id="@customer.Id" class="text-decoration-none">@customer.Name</a>
                        </td>
                        <td>@(customer.Phone ?? "—")</td>
                        <td class="text-truncate" style="max-width: 240px;">@(customer.Address ?? "—")</td>
                        <td class="text-end @(customer.Balance > 0 ? "text-danger fw-semibold" : "")">
                            Rs. @customer.Balance.ToString("N2")
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-secondary" title="View">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@customer.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete customer &quot;@customer.Name&quot;?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.Items.TotalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Items.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-page="@(Model.Items.Page - 1)">&laquo;</a>
                    </li>
                    @for (var p = 1; p <= Model.Items.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Items.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Items.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-page="@(Model.Items.Page + 1)">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
