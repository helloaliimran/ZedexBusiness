@model StockListViewModel
@{
    ViewData["Title"] = "Stock Entries";
    var isAdmin = User.IsInRole("Admin");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-boxes me-2"></i>Stock Entries</h3>
    <div>
        <a asp-action="OnHand" class="btn btn-outline-secondary">
            <i class="bi bi-clipboard-data me-1"></i>Stock on Hand
        </a>
        <a asp-action="ResetLog" class="btn btn-outline-secondary">
            <i class="bi bi-clock-history me-1"></i>Reset Log
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>New Stock Entry
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-12 col-md-3">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Reference or remarks..." />
            </div>
            <div class="col-6 col-md-2">
                <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-6 col-md-2">
                <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-funnel me-1"></i>Filter</button>
            </div>
            @if (!string.IsNullOrEmpty(Model.Search) || Model.From is not null || Model.To is not null)
            {
                <div class="col-auto"><a asp-action="Index" class="btn btn-link">Clear</a></div>
            }
        </form>

        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Entry #</th>
                    <th>Date</th>
                    <th>Reference</th>
                    <th class="text-end">Lines</th>
                    <th class="text-end">Total items</th>
                    <th>Status</th>
                    <th>Entered by</th>
                    <th></th>
                    <th class="text-end" style="width: 190px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Items.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-4"><i class="bi bi-inbox me-1"></i>No stock entries found.</td></tr>
                }
                @foreach (var entry in Model.Items.Items)
                {
                    <tr>
                        <td class="fw-medium">#@entry.Id</td>
                        <td>@entry.EntryDate.ToString("dd MMM yyyy")</td>
                        <td>@(entry.ReferenceNumber ?? "—")</td>
                        <td class="text-end">@entry.LineCount</td>
                        <td class="text-end">@entry.TotalItems.ToString("N0")</td>
                        <td>
                            <span class="badge @(entry.IsPosted ? "text-bg-success" : "text-bg-secondary")">
                                @(entry.IsPosted ? "Posted" : "Draft")
                            </span>
                        </td>
                        <td>@(entry.CreatedBy ?? "—")</td>
                        <td>
                            @if (entry.HasAttachment)
                            {
                                <i class="bi bi-paperclip text-muted" title="Has attachment"></i>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@entry.Id" class="btn btn-sm btn-outline-primary" title="View">
                                <i class="bi bi-eye"></i>
                            </a>
                            @if (!entry.IsPosted)
                            {
                                <a asp-action="Edit" asp-route-id="@entry.Id" class="btn btn-sm btn-outline-secondary" title="Edit draft">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Post" asp-route-id="@entry.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Post stock entry #@entry.Id? Stock will be updated and the entry locked.');">
                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Post stock">
                                        <i class="bi bi-send-check"></i>
                                    </button>
                                </form>
                            }
                            @if (!entry.IsPosted || isAdmin)
                            {
                                <form asp-action="Delete" asp-route-id="@entry.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('@(entry.IsPosted ? $"Delete posted entry #{entry.Id}? Quantities will be reversed." : $"Delete draft entry #{entry.Id}?")');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="@(entry.IsPosted ? "Delete & reverse" : "Delete draft")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.Items.TotalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Items.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
                           asp-route-page="@(Model.Items.Page - 1)">&laquo;</a>
                    </li>
                    @for (var p = 1; p <= Model.Items.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Items.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                               asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
                               asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Items.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
                           asp-route-page="@(Model.Items.Page + 1)">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
