@model StockResetLogListViewModel
@{
    ViewData["Title"] = "Stock Reset Log";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-clock-history me-2"></i>Stock Reset Log</h3>
    <a asp-action="OnHand" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Stock on hand</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Product</th>
                    <th class="text-end">Previous stock</th>
                    <th class="text-end">Pieces cleared</th>
                    <th>Remarks</th>
                    <th>Reset by</th>
                    <th>Batch</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Items.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4"><i class="bi bi-inbox me-1"></i>No stock resets recorded.</td></tr>
                }
                @foreach (var row in Model.Items.Items)
                {
                    <tr>
                        <td>@row.ResetDate.ToString("dd MMM yyyy HH:mm")</td>
                        <td class="fw-medium">@row.ProductName</td>
                        <td class="text-end">@row.PreviousStock.ToString("N2")</td>
                        <td class="text-end">@(row.PiecesCleared > 0 ? row.PiecesCleared.ToString("N0") : "—")</td>
                        <td>@(row.Remarks ?? "—")</td>
                        <td class="small text-muted">@(row.ResetBy ?? "—")</td>
                        <td class="small text-muted">
                            @if (row.BatchId is not null)
                            {
                                <span class="badge text-bg-light border" title="Reset-all batch">
                                    <i class="bi bi-x-octagon me-1"></i>batch
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.Items.TotalPages > 1)
        {
            <nav class="p-3 pt-0">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Items.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-action="ResetLog" asp-route-page="@(Model.Items.Page - 1)">&laquo;</a>
                    </li>
                    @for (var p = 1; p <= Model.Items.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Items.Page ? "active" : "")">
                            <a class="page-link" asp-action="ResetLog" asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Items.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-action="ResetLog" asp-route-page="@(Model.Items.Page + 1)">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
