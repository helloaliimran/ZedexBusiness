@model OnHandViewModel
@{
    ViewData["Title"] = "Stock on Hand";
    var isAdmin = User.IsInRole("Admin");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-clipboard-data me-2"></i>Stock on Hand</h3>
    <div>
        <a asp-action="ResetLog" class="btn btn-outline-secondary"><i class="bi bi-clock-history me-1"></i>Reset Log</a>
        @if (isAdmin)
        {
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#resetAllModal">
                <i class="bi bi-x-octagon me-1"></i>Reset All to Zero
            </button>
        }
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Stock entries</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-auto">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search products..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search me-1"></i>Search</button>
            </div>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <div class="col-auto"><a asp-action="OnHand" class="btn btn-link">Clear</a></div>
            }
        </form>

        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Company</th>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Color</th>
                    <th>Gauge</th>
                    <th class="text-end">Stock</th>
                    <th>Piece breakdown</th>
                    @if (isAdmin)
                    {
                        <th class="text-end" style="width: 70px;"></th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Items.Any())
                {
                    <tr><td colspan="@(isAdmin ? 8 : 7)" class="text-center text-muted py-4"><i class="bi bi-inbox me-1"></i>No stock on hand.</td></tr>
                }
                @foreach (var item in Model.Items.Items)
                {
                    <tr>
                        <td>@item.Company</td>
                        <td class="fw-medium">@item.Name</td>
                        <td>@item.Category</td>
                        
                        <td>@item.Color</td>
                        <td>@item.Gauge</td>
                        <td class="text-end @(item.StockValue < 0 ? "text-danger fw-semibold" : "fw-semibold")">
                            @(item.IsPvc ? $"{item.StockQty:N0} qty" : item.Mode == PricingMode.PerFoot ? $"{item.CurrentStock:N2} ft" : $"{item.CurrentStock:N0} units")
                        </td>
                        <td>
                            @if (item.Mode == PricingMode.PerFoot)
                            {
                                @foreach (var piece in item.Pieces)
                                {
                                    <span class="badge text-bg-light border me-1 mb-1">
                                        @piece.LengthFt.ToString("0.##") ft × @piece.Quantity
                                    </span>
                                }
                                @if (!item.Pieces.Any())
                                {
                                    <span class="text-muted">—</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        @if (isAdmin)
                        {
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-danger reset-product-btn"
                                        data-bs-toggle="modal" data-bs-target="#resetProductModal"
                                        data-product-id="@item.ProductId" data-product-name="@item.Name"
                                        title="Reset stock to zero">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.Items.TotalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Items.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-action="OnHand" asp-route-search="@Model.Search"
                           asp-route-page="@(Model.Items.Page - 1)">&laquo;</a>
                    </li>
                    @for (var p = 1; p <= Model.Items.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Items.Page ? "active" : "")">
                            <a class="page-link" asp-action="OnHand" asp-route-search="@Model.Search" asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Items.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-action="OnHand" asp-route-search="@Model.Search"
                           asp-route-page="@(Model.Items.Page + 1)">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

@if (isAdmin)
{
    <div class="modal fade" id="resetProductModal" tabindex="-1">
        <div class="modal-dialog">
            <form asp-controller="Stock" asp-action="ResetProduct" method="post" class="modal-content">
                <input type="hidden" name="productId" id="resetProductId" value="" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-x-circle me-1"></i>Reset Stock — <span id="resetProductName"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-danger">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        This sets the product's stock (and per-length piece breakdown, if any) to zero.
                        This cannot be undone — it will be recorded in the Reset Log.
                    </p>
                    <div class="mb-2">
                        <label class="form-label">Reason (optional)</label>
                        <input type="text" name="remarks" class="form-control" maxlength="500"
                               placeholder="e.g. Physical count correction" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-x-circle me-1"></i>Reset to zero</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="resetAllModal" tabindex="-1">
        <div class="modal-dialog">
            <form asp-controller="Stock" asp-action="ResetAll" method="post" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-x-octagon me-1"></i>Reset ALL Stock to Zero</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-danger">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        This sets stock to zero for <strong>every product that currently has stock</strong>
                        (units, feet, and per-length pieces). This cannot be undone — each product will be
                        recorded in the Reset Log under one batch.
                    </p>
                    <div class="mb-2">
                        <label class="form-label">Reason (optional)</label>
                        <input type="text" name="remarks" class="form-control" maxlength="500"
                               placeholder="e.g. Annual stock count reset" />
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="confirmResetAll" required />
                        <label class="form-check-label" for="confirmResetAll">
                            I understand this resets every product's stock and cannot be undone.
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-x-octagon me-1"></i>Reset all to zero</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.reset-product-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('resetProductId').value = btn.dataset.productId;
                document.getElementById('resetProductName').textContent = btn.dataset.productName;
            });
        });
    </script>
}
