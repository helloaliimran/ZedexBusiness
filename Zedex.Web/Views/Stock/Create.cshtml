@model StockHeaderFormViewModel
@{
    ViewData["Title"] = "New Stock Entry";
}

<h3 class="mb-3"><i class="bi bi-boxes me-2"></i>New Stock Entry <span class="badge text-bg-secondary">Draft</span></h3>
<p class="text-muted">The entry is saved as a draft. Stock quantities are applied only when you post it.</p>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <partial name="_StockEntryForm" model="Model" />
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i>Save draft
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.stockProducts = @Html.Raw(Json.Serialize(ViewBag.ProductsJson));
        window.stockInitialRows = @Html.Raw(Json.Serialize(Model.Details));
    </script>
    <script src="~/js/product-search.js" asp-append-version="true"></script>
    <script src="~/js/stock-entry.js" asp-append-version="true"></script>
}
