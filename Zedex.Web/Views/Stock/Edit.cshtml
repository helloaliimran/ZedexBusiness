@model StockHeaderFormViewModel
@{
    ViewData["Title"] = $"Edit Stock Entry #{Model.Id}";
}

<h3 class="mb-3"><i class="bi bi-boxes me-2"></i>Edit Stock Entry #@Model.Id <span class="badge text-bg-secondary">Draft</span></h3>
<p class="text-muted">You can add, change, or remove lines while the entry is a draft. Post it to apply the quantities to stock.</p>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <partial name="_StockEntryForm" model="Model" />
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-lg me-1"></i>Save changes
    </button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.stockProducts = @Html.Raw(Json.Serialize(ViewBag.ProductsJson));
        window.stockInitialRows = @Html.Raw(Json.Serialize(Model.Details));
    </script>
    <script src="~/js/product-search.js" asp-append-version="true"></script>
    <script src="~/js/stock-entry.js" asp-append-version="true"></script>
}
