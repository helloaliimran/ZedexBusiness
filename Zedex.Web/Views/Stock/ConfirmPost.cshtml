@model StockPostConfirmViewModel
@{
    ViewData["Title"] = $"Confirm Posting — Stock Entry #{Model.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">
        <i class="bi bi-exclamation-triangle text-warning me-2"></i>Duplicate lines found
    </h3>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to entry
    </a>
</div>

<div class="alert alert-warning">
    <div class="fw-semibold mb-1">
        Stock entry #@Model.Id
        @if (!string.IsNullOrEmpty(Model.ReferenceNumber))
        {
            <span class="text-muted fw-normal">(@Model.ReferenceNumber)</span>
        }
        — @Model.EntryDate.ToString("dd MMM yyyy")
    </div>
    @Model.DuplicateLineCount lines across @Model.Groups.Count
    @(Model.Groups.Count == 1 ? "product" : "products") refer to the same item.
    Posting will <strong>merge</strong> each group into a single stock figure, shown below.
    If any of these is a double entry, go back and edit the draft instead.
</div>

@foreach (var dup in Model.Groups)
{
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="fw-semibold">
                @dup.Product
                @if (dup.Mode == PricingMode.PerFoot)
                {
                    <span class="badge text-bg-warning ms-1">Per Foot</span>
                    <span class="badge text-bg-light border ms-1">@(dup.LengthFt?.ToString("N2")) ft pieces</span>
                }
            </span>
            <span class="badge text-bg-danger">@dup.Lines.Count duplicate lines</span>
        </div>
        <div class="card-body p-0">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Line</th>
                        <th class="text-end">Units/Pieces</th>
                        <th class="text-end">Cartons</th>
                        <th class="text-end">Items/Carton</th>
                        <th class="text-end">Total qty</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in dup.Lines)
                    {
                        <tr>
                            <td class="fw-medium">Line @line.LineNumber</td>
                            <td class="text-end">@(line.Quantity?.ToString() ?? "—")</td>
                            <td class="text-end">@(line.Cartons?.ToString() ?? "—")</td>
                            <td class="text-end">@(line.ItemsPerCarton?.ToString() ?? "—")</td>
                            <td class="text-end">@line.TotalQuantity.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-semibold">
                    <tr>
                        <td colspan="4">
                            <i class="bi bi-arrow-down-up me-1"></i>After merge
                            @if (dup.MergedFeet is not null)
                            {
                                <span class="text-muted fw-normal">
                                    — @dup.MergedQuantity.ToString("N0") pieces &times;
                                    @(dup.LengthFt?.ToString("N2")) ft =
                                    @(dup.MergedFeet?.ToString("N2")) ft
                                </span>
                            }
                        </td>
                        <td class="text-end">@dup.MergedQuantity.ToString("N0")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

<div class="d-flex gap-2 flex-wrap">
    <form asp-action="Post" asp-route-id="@Model.Id" method="post" class="d-inline"
          onsubmit="return confirm('Merge the duplicate lines and post stock entry #@Model.Id? Stock will be updated and the entry locked.');">
        <input type="hidden" name="confirmMerge" value="true" />
        <button type="submit" class="btn btn-success">
            <i class="bi bi-check2-circle me-1"></i>Merge and post
        </button>
    </form>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
        <i class="bi bi-pencil me-1"></i>Edit entry instead
    </a>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
</div>
