@model QuotationDocumentViewModel
@{
    ViewData["Title"] = $"Quotation {Model.QuotationNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h3 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>@Model.QuotationNumber</h3>
        <div class="small text-muted">
            @Model.ClientName · Rs. @Model.GrandTotal.ToString("N2") · created @Model.CreatedDate.ToString("dd MMM yyyy HH:mm")@(Model.CreatedBy is null ? "" : $" by {Model.CreatedBy}")
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Pdf" asp-route-id="@Model.Id" class="btn btn-danger"><i class="bi bi-file-earmark-pdf me-1"></i>Download PDF</a>
        <a asp-action="Image" asp-route-id="@Model.Id" class="btn btn-success"><i class="bi bi-image me-1"></i>Download Image</a>
        <button type="button" class="btn btn-outline-success d-none" id="shareBtn"><i class="bi bi-share me-1"></i>Share</button>
        <a asp-action="Pdf" asp-route-id="@Model.Id" asp-route-download="false" target="_blank" class="btn btn-outline-secondary"><i class="bi bi-printer me-1"></i>Print</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Create" asp-route-copyFrom="@Model.Id" class="btn btn-outline-primary" title="New quotation with the same client, lines and terms"><i class="bi bi-copy me-1"></i>Duplicate</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
              onsubmit="return confirm('Delete quotation @Model.QuotationNumber?');">
            <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

@* The preview is the same image the client receives. *@
<div class="text-center">
    <img src="@Url.Action("Image", new { id = Model.Id, download = false })" alt="Quotation @Model.QuotationNumber"
         class="img-fluid shadow border bg-white" style="max-width: 820px; width: 100%;" />
</div>

@section Scripts {
<script>
    // Share the image straight to WhatsApp etc. where the browser supports file sharing (mostly phones).
    (function () {
        const btn = document.getElementById('shareBtn');
        const probe = new File([new Blob()], 'q.png', { type: 'image/png' });
        if (!navigator.canShare || !navigator.canShare({ files: [probe] })) return;
        btn.classList.remove('d-none');
        btn.addEventListener('click', async () => {
            btn.disabled = true;
            try {
                const res = await fetch('@Url.Action("Image", new { id = Model.Id, download = false })');
                const blob = await res.blob();
                const file = new File([blob], '@(Model.FileBaseName).png', { type: 'image/png' });
                await navigator.share({ files: [file], title: 'Quotation @Model.QuotationNumber' });
            } catch (e) {
                if (e.name !== 'AbortError') alert('Could not share: ' + e.message);
            } finally {
                btn.disabled = false;
            }
        });
    })();
</script>
}
