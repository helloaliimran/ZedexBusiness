@model QuotationFormViewModel
@{
    ViewData["Title"] = "Edit Quotation";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Edit Quotation</h3>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>All quotations</a>
</div>

<div class="card shadow-sm" style="max-width: 1100px;">
    <div class="card-body">
        <form asp-action="Edit" method="post" id="quotationForm">
            <partial name="_QuotationForm" model="Model" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save changes</button>
                <a asp-action="@(Model.Id == 0 ? "Index" : "Details")" asp-route-id="@(Model.Id == 0 ? null : Model.Id)" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/quotation-entry.js" asp-append-version="true"></script>
}
