@model QuotationListViewModel
@{
    ViewData["Title"] = "Quotations";
    string? F(DateTime? d) => d?.ToString("yyyy-MM-dd");
    var filterRoute = new Dictionary<string, string>
    {
        ["from"] = F(Model.From) ?? "",
        ["to"] = F(Model.To) ?? "",
        ["search"] = Model.Search ?? ""
    };
    Dictionary<string, string> PageRoute(int p) => new(filterRoute) { ["page"] = p.ToString() };
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h3 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Quotations</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Quotation</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-6 col-md-2"><input type="date" name="from" value="@F(Model.From)" class="form-control" title="From" /></div>
    <div class="col-6 col-md-2"><input type="date" name="to" value="@F(Model.To)" class="form-control" title="To" /></div>
    <div class="col-8 col-md-4"><input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Client, number, contact or address..." /></div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-funnel me-1"></i>Apply</button>
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Quotation No.</th>
                        <th>Date</th>
                        <th>Client</th>
                        <th>Contact</th>
                        <th>Project address</th>
                        <th class="text-end">Lines</th>
                        <th class="text-end">Grand total</th>
                        <th class="text-end" style="width:210px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Items.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4"><i class="bi bi-inbox me-1"></i>No quotations found.</td></tr>
                    }
                    @foreach (var q in Model.Items.Items)
                    {
                        <tr>
                            <td class="text-nowrap"><a asp-action="Details" asp-route-id="@q.Id" class="fw-semibold">@q.QuotationNumber</a></td>
                            <td class="text-nowrap">@q.QuotationDate.ToString("dd MMM yyyy")</td>
                            <td>@q.ClientName</td>
                            <td class="text-nowrap">@(q.ContactNumber ?? "—")</td>
                            <td class="small">@(q.ProjectAddress ?? "—")</td>
                            <td class="text-end">@q.ItemCount</td>
                            <td class="text-end fw-semibold">@q.GrandTotal.ToString("N2")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@q.Id" class="btn btn-sm btn-outline-secondary" title="View"><i class="bi bi-eye"></i></a>
                                <a asp-action="Pdf" asp-route-id="@q.Id" class="btn btn-sm btn-outline-danger" title="Download PDF"><i class="bi bi-file-earmark-pdf"></i></a>
                                <a asp-action="Image" asp-route-id="@q.Id" class="btn btn-sm btn-outline-success" title="Download image"><i class="bi bi-image"></i></a>
                                <a asp-action="Edit" asp-route-id="@q.Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@q.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete quotation @q.QuotationNumber?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Model.Items.Items.Any())
                {
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="6" class="fw-semibold">Total of @Model.Items.TotalCount quotation(s)</td>
                            <td class="text-end fw-bold">@Model.TotalAmount.ToString("N2")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

@if (Model.Items.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.Items.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(Model.Items.Page - 1)">&laquo;</a>
            </li>
            @for (var p = 1; p <= Model.Items.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Items.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(p)">@p</a>
                </li>
            }
            <li class="page-item @(Model.Items.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(Model.Items.Page + 1)">&raquo;</a>
            </li>
        </ul>
    </nav>
}
