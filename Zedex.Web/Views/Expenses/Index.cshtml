@model ExpenseListViewModel
@{
    ViewData["Title"] = "Expenses";
    var isAdmin = User.IsInRole("Admin");
    string F(DateTime d) => d.ToString("yyyy-MM-dd");
    var filterRoute = new Dictionary<string, string>
    {
        ["from"] = F(Model.From),
        ["to"] = F(Model.To),
        ["categoryId"] = Model.CategoryId?.ToString() ?? "",
        ["source"] = Model.Source?.ToString() ?? "",
        ["search"] = Model.Search ?? ""
    };
    Dictionary<string, string> PageRoute(int p) => new(filterRoute) { ["page"] = p.ToString() };
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h3 class="mb-0"><i class="bi bi-wallet2 me-2"></i>Expenses</h3>
    <div>
        <a asp-action="Excel" asp-all-route-data="filterRoute" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
        <a asp-action="Pdf" asp-all-route-data="filterRoute" class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Expense</a>
    </div>
</div>

@* ---- Quick add (today, most common case) ---- *@
<div class="card shadow-sm mb-3 border-primary-subtle">
    <div class="card-body py-2">
        <form asp-action="Create" asp-route-quick="true" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
            <div class="col-6 col-md-2">
                <label class="form-label small mb-0">Date</label>
                <input type="date" name="ExpenseDate" value="@F(DateTime.Today)" class="form-control form-control-sm" required />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-0">Category</label>
                <select name="ExpenseCategoryId" class="form-select form-select-sm" asp-items="ViewBag.Categories" required>
                    <option value="">— Select —</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-0">Amount (Rs.)</label>
                <input type="number" name="Amount" step="0.01" min="0.01" class="form-control form-control-sm" required />
            </div>
            <div class="col-6 col-md-1">
                <label class="form-label small mb-0">Paid from</label>
                <select name="PaymentSource" class="form-select form-select-sm">
                    <option value="Cash" selected>Cash</option>
                    <option value="Online">Online</option>
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small mb-0">Description</label>
                <input type="text" name="Description" maxlength="500" class="form-control form-control-sm"
                       placeholder="e.g. Lunch for 4 staff / 20 water bottles" required />
            </div>
            <div class="col-12 col-md-1 d-grid">
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Add</button>
            </div>
        </form>
    </div>
</div>

@* ---- Filters ---- *@
<form method="get" class="row g-2 mb-3">
    <div class="col-6 col-md-2"><input type="date" name="from" value="@F(Model.From)" class="form-control" /></div>
    <div class="col-6 col-md-2"><input type="date" name="to" value="@F(Model.To)" class="form-control" /></div>
    <div class="col-6 col-md-2">
        <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
            <option value="">All categories</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <select name="source" class="form-select">
            <option value="">Cash + Online</option>
            <option value="Cash" selected="@(Model.Source == PaymentSource.Cash)">Cash only</option>
            <option value="Online" selected="@(Model.Source == PaymentSource.Online)">Online only</option>
        </select>
    </div>
    <div class="col-8 col-md-2"><input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search description..." /></div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-funnel me-1"></i>Apply</button>
    </div>
</form>

@* ---- Totals ---- *@
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-start border-4 border-danger"><div class="card-body py-2">
            <div class="text-muted small">Total Expense (@Model.TotalCount)</div>
            <div class="fs-5 fw-bold text-danger">Rs. @Model.TotalAmount.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-start border-4 border-success"><div class="card-body py-2">
            <div class="text-muted small">From Cash</div>
            <div class="fs-5 fw-bold">Rs. @Model.CashTotal.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-start border-4 border-primary"><div class="card-body py-2">
            <div class="text-muted small">Online</div>
            <div class="fs-5 fw-bold">Rs. @Model.OnlineTotal.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm h-100"><div class="card-body py-2 small">
            @if (!Model.ByCategory.Any())
            {
                <span class="text-muted">No category totals.</span>
            }
            @foreach (var c in Model.ByCategory.Take(4))
            {
                <div class="d-flex justify-content-between"><span class="text-truncate me-2">@c.Category</span><span class="fw-semibold">@c.Amount.ToString("N0")</span></div>
            }
            @if (Model.ByCategory.Count > 4)
            {
                <div class="text-muted">+ @(Model.ByCategory.Count - 4) more</div>
            }
        </div></div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Paid from</th>
                    <th class="text-end">Amount</th>
                    <th>By</th>
                    <th class="text-end" style="width:140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Items.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4"><i class="bi bi-inbox me-1"></i>No expenses in this period.</td></tr>
                }
                @foreach (var e in Model.Items.Items)
                {
                    var editable = isAdmin || e.CreatedDate.Date == DateTime.Today;
                    <tr>
                        <td class="text-nowrap">@e.ExpenseDate.ToString("dd MMM yyyy")</td>
                        <td>@e.Category</td>
                        <td>
                            @e.Description
                            @if (e.HasAttachment)
                            {
                                <a asp-action="Attachment" asp-route-id="@e.Id" target="_blank" title="Receipt" class="ms-1"><i class="bi bi-paperclip"></i></a>
                            }
                        </td>
                        <td>
                            <span class="badge @(e.PaymentSource == PaymentSource.Cash ? "text-bg-success" : "text-bg-primary")">@e.PaymentSource</span>
                        </td>
                        <td class="text-end fw-semibold">@e.Amount.ToString("N2")</td>
                        <td class="small text-muted">@(e.CreatedBy ?? "—")</td>
                        <td class="text-end">
                            @if (editable)
                            {
                                <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@e.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this expense of Rs. @e.Amount.ToString("N2")?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                            else
                            {
                                <i class="bi bi-lock text-muted" title="Locked — admin only"></i>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            @if (Model.Items.Items.Any())
            {
                <tfoot class="table-light">
                    <tr>
                        <td colspan="4" class="fw-semibold">Total (all pages)</td>
                        <td class="text-end fw-bold text-danger">@Model.TotalAmount.ToString("N2")</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

@if (Model.Items.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.Items.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(Model.Items.Page - 1)">&laquo;</a>
            </li>
            @for (var p = 1; p <= Model.Items.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Items.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(p)">@p</a>
                </li>
            }
            <li class="page-item @(Model.Items.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(Model.Items.Page + 1)">&raquo;</a>
            </li>
        </ul>
    </nav>
}
