@model ExpenseFormViewModel
@{
    ViewData["Title"] = "Edit Expense";
}

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <h3 class="mb-3"><i class="bi bi-wallet2 me-2"></i>Edit Expense</h3>
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <partial name="_ExpenseForm" model="Model" />
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save expense</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
