@model ExpenseFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
<input type="hidden" asp-for="Id" />

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="ExpenseDate" class="form-label"></label>
        <input asp-for="ExpenseDate" class="form-control" type="date" />
        <span asp-validation-for="ExpenseDate" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ExpenseCategoryId" class="form-label"></label>
        <select asp-for="ExpenseCategoryId" class="form-select" asp-items="ViewBag.Categories">
            <option value="">— Select —</option>
        </select>
        <span asp-validation-for="ExpenseCategoryId" class="text-danger small"></span>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="Amount" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">Rs.</span>
            <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" autofocus />
        </div>
        <span asp-validation-for="Amount" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="PaymentSource" class="form-label"></label>
        <div>
            <div class="btn-group" role="group">
                <input type="radio" class="btn-check" asp-for="PaymentSource" id="srcCash" value="@PaymentSource.Cash" />
                <label class="btn btn-outline-success" for="srcCash"><i class="bi bi-cash me-1"></i>Cash</label>
                <input type="radio" class="btn-check" asp-for="PaymentSource" id="srcOnline" value="@PaymentSource.Online" />
                <label class="btn btn-outline-primary" for="srcOnline"><i class="bi bi-phone me-1"></i>Online</label>
            </div>
        </div>
        <div class="form-text">Cash = taken from today's sales cash. Online = bank / JazzCash / EasyPaisa.</div>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="2"
              placeholder="e.g. Lunch for 4 staff / 20 water bottles / tape rolls for shop"></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Attachment" class="form-label"></label>
    <input asp-for="Attachment" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,.pdf" />
    @if (Model.HasExistingAttachment)
    {
        <div class="form-text">
            <a asp-action="Attachment" asp-route-id="@Model.Id" target="_blank"><i class="bi bi-paperclip"></i> Current receipt</a>
            — uploading a new file replaces it.
        </div>
    }
    <span asp-validation-for="Attachment" class="text-danger small"></span>
</div>
