@model int
@{
    ViewData["Title"] = $"Error {Model}";
    var (icon, title, message) = Model switch
    {
        404 => ("bi-search", "Page not found", "The page or record you are looking for doesn't exist or may have been deleted."),
        403 => ("bi-shield-lock", "Access denied", "You don't have permission for this page. Contact your administrator."),
        _ => ("bi-exclamation-octagon", $"Error {Model}", "Something went wrong while processing your request.")
    };
}

<div class="text-center py-5">
    <i class="bi @icon fs-1 text-danger"></i>
    <h3 class="mt-3">@title</h3>
    <p class="text-muted">@message</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a>
</div>
